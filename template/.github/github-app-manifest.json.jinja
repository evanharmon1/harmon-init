{
  "name": "[[ github_org ]]-ci",
  "description": "CI automation app for [[ github_org ]]: mints short-lived tokens for release-please, Claude Code, and project automation. See docs/architecture/security.md.",
  "url": "[[ repo_url ]]",
  "redirect_url": "[% if github_org != author_git_provider_username %]https://github.com/organizations/[[ github_org ]]/settings/apps[% else %]https://github.com/settings/apps[% endif %]",
  "hook_attributes": {
    "url": "[[ repo_url ]]",
    "active": false
  },
  "public": false,
  "default_permissions": {
    "contents": "write",
    "pull_requests": "write",
    "issues": "write",
    "workflows": "write",
    "metadata": "read"[% if github_org != author_git_provider_username %],
    "actions": "read",
    "members": "read",
    "organization_projects": "write"[% endif %]
  }
}
