name: Task
description: General work — maintenance, chores, cleanup, or a small improvement
assignees:
  - [[ author_git_provider_username ]]
[% if github_org != author_git_provider_username %]
type: Task
[% endif %]
[# labels: is gated on the same condition as scripts/setup-github-labels.sh's
   own file inclusion (project_management == 'github' or use_foreman): an
   unprovisioned repo's forms apply no labels at all, rather than
   referencing ones nothing guarantees. #]
[% if project_management == 'github' or use_foreman %]
labels:
[% if github_org != author_git_provider_username %]
  - needs-triage
[% else %]
  - task
  - needs-triage
[% endif %]
[% endif %]
body:
  - type: textarea
    id: description
    attributes:
      label: Problem
      description: Briefly describe the task and the outcome it should achieve.
    validations:
      required: true
  - type: textarea
    id: acceptance
    attributes:
      label: Acceptance criteria
      description: >-
        Optional. One `- [ ]` item per criterion; tag `[CI]`/`[HUMAN]` where
        useful. Leave blank to file without criteria — triage adds them
        before this is dispatched.
[% if project_management == 'github' %]
        Human-only follow-ups (secrets, settings,
        manual QA) belong on the issue's `(HUMAN):` or `(QA):` collector —
        its milestone's, else its epic's, else the repo-wide one — not here.
[% endif %]
  - type: textarea
    id: context
    attributes:
      label: Additional context
