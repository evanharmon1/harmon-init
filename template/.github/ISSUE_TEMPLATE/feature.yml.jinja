name: Feature
description: Suggest a new capability or improvement
assignees:
  - [[ author_git_provider_username ]]
[% if github_org != author_git_provider_username %]
type: Feature
[% endif %]
[# labels: is gated on the same condition as scripts/setup-github-labels.sh's
   own file inclusion (project_management == 'github' or use_foreman): an
   unprovisioned repo's forms apply no labels at all, rather than
   referencing ones nothing guarantees. #]
[% if project_management == 'github' or use_foreman %]
labels:
[% if github_org != author_git_provider_username %]
  - needs-triage
[% else %]
  - enhancement
  - needs-triage
[% endif %]
[% endif %]
body:
  - type: textarea
    id: problem
    attributes:
      label: Problem
      description: What problem does this solve? (e.g. "I'm frustrated when …")
    validations:
      required: true
  - type: textarea
    id: solution
    attributes:
      label: Proposed solution
      description: What you'd like to happen.
    validations:
      required: true
  - type: textarea
    id: acceptance
    attributes:
      label: Acceptance criteria
      description: >-
        Optional. One `- [ ]` item per criterion; tag `[CI]`/`[HUMAN]` where
        useful. Leave blank to file without criteria — triage adds them
        before this is dispatched.
  - type: textarea
    id: alternatives
    attributes:
      label: Alternatives considered
