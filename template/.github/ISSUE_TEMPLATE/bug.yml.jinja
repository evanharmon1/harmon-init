name: Bug
description: Report something that's broken or behaving incorrectly
assignees:
  - [[ author_git_provider_username ]]
[% if github_org != author_git_provider_username %]
type: Bug
[% endif %]
[# labels: is gated on the same condition as scripts/setup-github-labels.sh's
   own file inclusion (project_management == 'github' or use_foreman): an
   unprovisioned repo's forms apply no labels at all, rather than
   referencing ones nothing guarantees. #]
[% if project_management == 'github' or use_foreman %]
labels:
[% if github_org != author_git_provider_username %]
  - needs-triage
[% else %]
  - bug
  - needs-triage
[% endif %]
[% endif %]
body:
  - type: textarea
    id: what-happened
    attributes:
      label: Problem
      description: A clear description of the bug, and what you expected instead.
    validations:
      required: true
  - type: textarea
    id: repro
    attributes:
      label: Steps to reproduce
      placeholder: |
        1. Go to '...'
        2. Click '...'
        3. See error
    validations:
      required: true
  - type: input
    id: environment
    attributes:
      label: Environment
      description: OS, browser/app version, device — whatever's relevant.
      placeholder: "e.g. macOS 15 · Chrome 130 · app v1.2.3"
  - type: textarea
    id: context
    attributes:
      label: Additional context
      description: Logs, screenshots, or anything else that helps.
