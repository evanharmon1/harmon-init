name: Build & Validate

on:
  push:
    branches:
      - main
  # No `edited`: it fires on a PR title/body edit, and the dev loop's readiness
  # gate REQUIRES body edits (ticking `## Deferred findings`), so carrying it
  # here made satisfying one gate condition invalidate another — every
  # settlement restarted the whole matrix. `edited` also fires on a
  # base-BRANCH change; dropping that re-run is deliberate. Retargeting a PR
  # is rare, and a strict required-status-checks policy already forces an
  # up-to-date head before merge, which lands as a `synchronize` this list
  # does cover. Title/body-dependent guards keep `edited` in their OWN
  # workflows: closing-keywords.yml[% if use_release_please and release_content_paths %] and release-content-guard.yml[% endif %].
  pull_request:
    types: [opened, synchronize, reopened]
    branches:
      - main
  merge_group:
  workflow_dispatch:

# Parallel jobs that all call into the Taskfile so local + CI run identical commands.
# A final `verify` job aggregates statuses for branch protection
# (required checks: verify + security). Every job's toolchain setup goes through
# the shared ./.github/actions/setup composite action.

concurrency:
  group: build-${{ github.ref }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

permissions:
  contents: read

jobs:
  changes:
    runs-on: ${{ fromJSON(vars.CI_RUNS_ON || '[[ ci_runs_on_default ]]') }}
    if: >-
      github.event_name != 'pull_request' ||
      github.event.pull_request.head.repo.full_name == github.repository
    timeout-minutes: 5
    outputs:
      docs_only: ${{ steps.classify.outputs.docs_only }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
          # Both parents of the PR merge ref: first parent is the live base.
          fetch-depth: 2
      - name: Classify docs-only changes (fail closed)
        id: classify
        run: ./scripts/ci-changes-classify.sh >> "$GITHUB_OUTPUT"

  check:
    # Runner switch: CI_RUNS_ON repo/org variable unset -> the rendered
    # default; set it to a JSON runner spec to override without a commit.
    runs-on: ${{ fromJSON(vars.CI_RUNS_ON || '[[ ci_runs_on_default ]]') }}
    if: >-
      github.event_name != 'pull_request' ||
      github.event.pull_request.head.repo.full_name == github.repository
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
          # Full history so `task check`'s pin-pair guard can diff against the
          # PR's merge-base: it is the only check that catches a Renovate bump
          # that moved a tool's version but not its checksum, and it fails
          # rather than skipping on a pull request without that history.
          fetch-depth: 0
      - uses: ./.github/actions/setup
        with:
          lint-tools: "true"
      - name: Check
        run: task check

[% if project_type == 'web-app' %]
  codegen-guard:
    needs: changes
    # Secret-holding codegen uses disposable runners, never the default pool.
    runs-on: ${{ fromJSON(vars.ISOLATED_RUNS_ON || '"ubuntu-latest"') }}
    if: >-
      !cancelled() &&
      (github.event_name != 'pull_request' ||
       (github.event.pull_request.head.repo.full_name == github.repository &&
        (needs.changes.result != 'success' || needs.changes.outputs.docs_only != 'true')))
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
          fetch-depth: 0
      - uses: ./.github/actions/setup
        with:
          cache: "false"
      - name: Generated code is current
        env:
          CONVEX_DEPLOY_KEY: ${{ github.event_name != 'merge_group' && secrets.CONVEX_DEPLOY_KEY || '' }}
        run: task guard:codegen
[% endif %]

  repo-guards:
    # Runner switch: CI_RUNS_ON repo/org variable unset -> the rendered
    # default; set it to a JSON runner spec to override without a commit.
    runs-on: ${{ fromJSON(vars.CI_RUNS_ON || '[[ ci_runs_on_default ]]') }}
    if: >-
      github.event_name != 'pull_request' ||
      github.event.pull_request.head.repo.full_name == github.repository
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
          fetch-depth: 0
      - uses: ./.github/actions/setup
        with:
          lint-tools: "true"
      # Outside ci:repo-guards: deleting its suite call must not silence this guard.
      - name: Verify-CI parity guard (runs outside the task it guards)
        run: task test:verify-ci-parity
      - name: Repository guards
        run: task ci:repo-guards
[% if devcontainer %]

  devcontainer-permissions:
    needs: changes
    # Runner switch: CI_RUNS_ON repo/org variable unset -> the rendered
    # default; set it to a JSON runner spec to override without a commit.
    runs-on: ${{ fromJSON(vars.CI_RUNS_ON || '[[ ci_runs_on_default ]]') }}
    if: >-
      !cancelled() &&
      (github.event_name != 'pull_request' ||
       (github.event.pull_request.head.repo.full_name == github.repository &&
        (needs.changes.result != 'success' || needs.changes.outputs.docs_only != 'true')))
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
          fetch-depth: 0
      - uses: ./.github/actions/setup
      - name: Devcontainer permissions
        run: task test:devcontainer:permissions
[% endif %]
[% if use_node %]

  build-test:
    needs: changes
    # Runner switch: CI_RUNS_ON repo/org variable unset -> the rendered
    # default; set it to a JSON runner spec to override without a commit.
    runs-on: ${{ fromJSON(vars.CI_RUNS_ON || '[[ ci_runs_on_default ]]') }}
    if: >-
      !cancelled() &&
      (github.event_name != 'pull_request' ||
       (github.event.pull_request.head.repo.full_name == github.repository &&
        (needs.changes.result != 'success' || needs.changes.outputs.docs_only != 'true')))
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: ./.github/actions/setup
[% if project_type == 'web-astro' %]
      - name: Install lychee
        uses: lycheeverse/lychee-action@8646ba30535128ac92d33dfc9133794bfdd9b411 # v2.8.0
        with:
          args: --version
          fail: false
[% endif %]
      - name: Build
        run: task build
      - name: Validate
        run: task validate
      - name: Test
        run: task test

  e2e:
    needs: changes
    # End-to-end (Playwright) — the PORT-BINDING test tier. It gets its own job
    # rather than joining build-test because `task verify` (and every other
    # agent-facing tier) is deliberately port-free; only `task ci` and this job
    # serve the app. BLOCKING: listed in verify.needs below.
    #
    # Self-activates once the app ships a playwright.config.* — before then
    # `task test:e2e` skips cleanly. Step order is deliberate: detect the config,
    # run the fail-closed env guard BEFORE anything else touches the e2e
    # environment, then install browsers and build (so the Playwright
    # `webServer` has a dist/ to preview, mirroring the ordering `task ci` gets
    # from verify). Once a config exists, scripts/e2e-env-guard.sh must be
    # configured or this check fails (fail-closed by design).
    #
    # BROWSER_RUNS_ON selects this class; CI_RUNS_ON and the rendered
    # default remain its fallbacks. Values are JSON runner label sets.
    runs-on: ${{ fromJSON(vars.BROWSER_RUNS_ON || vars.CI_RUNS_ON || '[[ ci_runs_on_default ]]') }}
    if: >-
      !cancelled() &&
      (github.event_name != 'pull_request' ||
       (github.event.pull_request.head.repo.full_name == github.repository &&
        (needs.changes.result != 'success' || needs.changes.outputs.docs_only != 'true')))
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - name: Detect Playwright config
        id: pw
        run: |
          if find . -maxdepth 1 -name 'playwright.config.*' 2>/dev/null | grep -q .; then
            echo "present=true" >> "$GITHUB_OUTPUT"
          else
            echo "present=false" >> "$GITHUB_OUTPUT"
          fi
      # FIRST, before dependency install / browsers / build. `task test:e2e`
      # runs this same guard again, but by then `pnpm install` has executed
      # lifecycle scripts and the build has run — with whatever e2e env this job
      # was given in scope. A fail-closed guard that fires after the things it
      # protects against is not fail-closed, and running it here also fails an
      # unconfigured guard in seconds instead of after a browser install.
      #
      # Invoked directly rather than through `task`: `task` itself is installed
      # by the setup step below. It is the same script the Taskfile calls, so
      # there is no second copy of the logic.
      - name: e2e environment guard (fail closed)
        if: steps.pw.outputs.present == 'true'
        run: ./scripts/e2e-env-guard.sh
      - uses: ./.github/actions/setup
        id: setup
        with:
          browsers: ${{ steps.pw.outputs.present == 'true' }}
          browser-set: all
      # Every browser, not just chromium: this job runs the WHOLE suite, and the
      # convention is multi-browser + mobile projects (see
      # docs/architecture/tests.md). Installing one browser would fail this
      # blocking check on any config that declares firefox/webkit projects.
      #
      # Split by runner environment for the same reason the lighthouse job's
      # Chrome install is: install-deps shells out to apt via sudo. Hosted
      # runners need that; self-hosted machines provide the shared libraries.
      # The separate idempotent install always checks that browsers are present,
      # even if a cache hit restored into a different runner workspace layout.
      - name: Install Playwright system dependencies (hosted runner — apt via sudo)
        if: steps.pw.outputs.present == 'true' && runner.environment == 'github-hosted'
        run: pnpm exec playwright install-deps
      - name: Download Playwright browsers (idempotent — no sudo/apt)
        if: steps.pw.outputs.present == 'true'
        run: pnpm exec playwright install
      - name: Build
        if: steps.pw.outputs.present == 'true'
        run: task build
      - name: End-to-end tests
        run: task test:e2e
[% endif %]

  security:
    # Runner switch: CI_RUNS_ON repo/org variable unset -> the rendered
    # default; set it to a JSON runner spec to override without a commit.
    runs-on: ${{ fromJSON(vars.CI_RUNS_ON || '[[ ci_runs_on_default ]]') }}
    if: >-
      github.event_name != 'pull_request' ||
      github.event.pull_request.head.repo.full_name == github.repository
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
          fetch-depth: 0
      - uses: ./.github/actions/setup
        with:
          gitleaks: "true"
      - name: Secrets scan
        run: task security:secrets
      - name: Dependency audit
        run: task security:audit
      - name: SAST (Semgrep Community Edition)
[% if use_codeql %]
        if: github.event.repository.private && vars.FULL_SECURITY_SCAN != 'true'
[% endif %]
        run: task security:sast
[% if project_type == 'web-astro' %]

  lighthouse:
    needs: changes
    # BROWSER_RUNS_ON selects this class; CI_RUNS_ON and the rendered
    # default remain its fallbacks. Values are JSON runner label sets.
    runs-on: ${{ fromJSON(vars.BROWSER_RUNS_ON || vars.CI_RUNS_ON || '[[ ci_runs_on_default ]]') }}
    if: >-
      !cancelled() &&
      (github.event_name != 'pull_request' ||
       (github.event.pull_request.head.repo.full_name == github.repository &&
        (needs.changes.result != 'success' || needs.changes.outputs.docs_only != 'true')))
    timeout-minutes: 30
    permissions:
      contents: read
      pull-requests: write
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: ./.github/actions/setup
      - name: Install Chrome (required for Lighthouse)
        uses: browser-actions/setup-chrome@2e1d749697dd1612b833dba4a722266286fbefcd # v2.1.2
        id: setup-chrome
        with:
          # Hosted runners need apt (via sudo) to install Chrome's shared libs;
          # persistent self-hosted machines already have them, so skip apt/sudo
          # there to avoid requiring passwordless sudo.
          install-dependencies: ${{ runner.environment == 'github-hosted' }}
          no-sudo: ${{ runner.environment != 'github-hosted' }}
      - name: Build
        run: task build
      - name: Lighthouse CI
        env:
          CHROME_PATH: ${{ steps.setup-chrome.outputs.chrome-path }}
        id: lighthouse
        uses: treosh/lighthouse-ci-action@3e7e23fb74242897f95c0ba9cabad3d0227b9b18 # v12
        with:
          configPath: ./lighthouserc.json
          uploadArtifacts: true
          temporaryPublicStorage: true
      - name: Comment Lighthouse results on PR
        if: github.event_name == 'pull_request'
        uses: actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3 # v9.0.0
        env:
          LHCI_LINKS: ${{ steps.lighthouse.outputs.links }}
          LHCI_RESULTS_PATH: ${{ steps.lighthouse.outputs.resultspath }}
        with:
          script: |
            const fs = require('fs')
            const path = require('path')
            const links = JSON.parse(process.env.LHCI_LINKS || '{}')
            const manifestPath = path.join(process.env.LHCI_RESULTS_PATH, 'manifest.json')
            const manifest = JSON.parse(fs.readFileSync(manifestPath, 'utf8'))
            const fmt = v => (v == null ? 'n/a' : Math.round(v * 100))
            const rows = manifest
              .filter(r => r.isRepresentativeRun)
              .map(r => {
                const s = r.summary
                const link = links[r.url] || ''
                const urlPath = r.url.replace('http://localhost', '') || '/'
                return `| \`${urlPath}\` | ${fmt(s.performance)} | ${fmt(s.accessibility)} | ${fmt(s['best-practices'])} | ${fmt(s.seo)} | [report](${link}) |`
              })
              .join('\n')
            const runUrl = `${context.serverUrl}/${context.repo.owner}/${context.repo.repo}/actions/runs/${context.runId}`
            const body = [
              '## Lighthouse CI Results',
              '',
              '| URL | Perf | A11y | BP | SEO | Report |',
              '|---|---|---|---|---|---|',
              rows,
              '',
              `_Run: [${context.runId}](${runUrl})_`,
            ].join('\n')
            const { data: comments } = await github.rest.issues.listComments({
              issue_number: context.issue.number,
              owner: context.repo.owner,
              repo: context.repo.repo,
            })
            const existing = comments.find(c =>
              c.user.type === 'Bot' && c.body.startsWith('## Lighthouse CI Results')
            )
            if (existing) {
              await github.rest.issues.updateComment({
                comment_id: existing.id,
                owner: context.repo.owner,
                repo: context.repo.repo,
                body,
              })
            } else {
              await github.rest.issues.createComment({
                issue_number: context.issue.number,
                owner: context.repo.owner,
                repo: context.repo.repo,
                body,
              })
            }

  render-parity:
    needs: changes
    # Proves a formatter-package bump didn't alter the built site's visible
    # text (see docs/CHECKLIST.md and scripts/test-astro-compress-parity.sh).
    # Builds the merge-base AND HEAD, so it is expensive — REQUIRED (listed in
    # verify.needs) rather than self-activating like e2e/a11y, so the job
    # itself runs on every non-docs change. Only a classifier-authorized
    # docs-only job skip is accepted by scripts/verify-ci-results.sh.
    # On other changes the job runs `task
    # test:render-parity` unconditionally; render-parity.sh itself carries
    # the ONE trigger predicate (only a change to a known formatter package,
    # never an ordinary `*.astro` content edit or an unrelated dependency
    # bump — harmon-init#1350 Codex review rounds 1-2, P1) and self-skips
    # cheaply otherwise. That predicate lives in exactly one place so `task
    # ci`/`task test:render-parity` behave identically locally and in CI —
    # duplicating it into a separate detection step here is what let an
    # earlier version drift out of sync with the script.
    #
    # Runner switch: CI_RUNS_ON repo/org variable unset -> the rendered
    # default; set it to a JSON runner spec to override without a commit.
    runs-on: ${{ fromJSON(vars.CI_RUNS_ON || '[[ ci_runs_on_default ]]') }}
    if: >-
      !cancelled() &&
      (github.event_name != 'pull_request' ||
       (github.event.pull_request.head.repo.full_name == github.repository &&
        (needs.changes.result != 'success' || needs.changes.outputs.docs_only != 'true')))
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
          # Full history: render-parity.sh resolves the merge-base itself and
          # builds it in a disposable git worktree.
          fetch-depth: 0
      - uses: ./.github/actions/setup
      - name: Render parity (merge-base vs. HEAD; self-skips on a non-formatter change)
        run: task test:render-parity
[% endif %]
[% if project_type in ['web-astro', 'web-app'] %]

  a11y:
    needs: changes
    # Accessibility (axe-core via Playwright). NON-BLOCKING for now: intentionally
    # NOT in the `verify` needs list, so it reports but does not gate merges.
    # Self-activates once the app ships a playwright.config.* (before then
    # `task test:a11y` skips). To promote to a required check: add `a11y` to
    # verify.needs + a `check a11y` line, and to the ruleset's required checks.
    runs-on: ${{ fromJSON(vars.BROWSER_RUNS_ON || vars.CI_RUNS_ON || '[[ ci_runs_on_default ]]') }}
    if: >-
      !cancelled() &&
      (github.event_name != 'pull_request' ||
       (github.event.pull_request.head.repo.full_name == github.repository &&
        (needs.changes.result != 'success' || needs.changes.outputs.docs_only != 'true')))
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - name: Detect Playwright config
        id: pw
        run: |
          if find . -maxdepth 1 -name 'playwright.config.*' 2>/dev/null | grep -q .; then
            echo "present=true" >> "$GITHUB_OUTPUT"
          else
            echo "present=false" >> "$GITHUB_OUTPUT"
          fi
      - uses: ./.github/actions/setup
        id: setup
        with:
          browsers: ${{ steps.pw.outputs.present == 'true' }}
          browser-set: chromium
      - name: Install Playwright system dependencies (hosted runner — apt via sudo)
        if: steps.pw.outputs.present == 'true' && runner.environment == 'github-hosted'
        run: pnpm exec playwright install-deps chromium
      - name: Download Playwright browsers (idempotent — no sudo/apt)
        if: steps.pw.outputs.present == 'true'
        run: pnpm exec playwright install chromium
      - name: Accessibility (axe) tests
        run: task test:a11y
[% endif %]

  verify:
    if: always()
    needs: [changes, check, repo-guards[% if project_type == 'web-app' %], codegen-guard[% endif %][% if devcontainer %], devcontainer-permissions[% endif %], security[% if use_node %], build-test, e2e[% endif %][% if project_type == 'web-astro' %], lighthouse, render-parity[% endif %]]
    # Runner switch: CI_RUNS_ON repo/org variable unset -> the rendered
    # default; set it to a JSON runner spec to override without a commit.
    runs-on: ${{ fromJSON(vars.CI_RUNS_ON || '[[ ci_runs_on_default ]]') }}
    env:
      CI_EVENT_NAME: ${{ github.event_name }}
      CHANGES_RESULT: ${{ needs.changes.result }}
      DOCS_ONLY: ${{ needs.changes.outputs.docs_only }}
      IS_FORK: ${{ github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name != github.repository }}
    steps:
      # Never check out or run fork-controlled repository code on this path.
      - name: Verify deliberate skips at the untrusted-fork boundary
        if: env.IS_FORK == 'true'
        env:
          CHECK_RESULT: ${{ needs.check.result }}
          REPO_GUARDS_RESULT: ${{ needs.repo-guards.result }}
[% if project_type == 'web-app' %]
          CODEGEN_GUARD_RESULT: ${{ needs.codegen-guard.result }}
[% endif %]
[% if devcontainer %]
          DEVCONTAINER_PERMISSIONS_RESULT: ${{ needs.devcontainer-permissions.result }}
[% endif %]
          SECURITY_RESULT: ${{ needs.security.result }}
[% if use_node %]
          BUILD_TEST_RESULT: ${{ needs.build-test.result }}
          E2E_RESULT: ${{ needs.e2e.result }}
[% endif %]
[% if project_type == 'web-astro' %]
          LIGHTHOUSE_RESULT: ${{ needs.lighthouse.result }}
          RENDER_PARITY_RESULT: ${{ needs.render-parity.result }}
[% endif %]
        run: |
          fail=0
          check_skipped() {
            if [ "$2" != "skipped" ]; then
              echo "Job $1 result: $2 (expected skipped for an untrusted fork)"
              fail=1
            fi
          }
          check_skipped changes "$CHANGES_RESULT"
          check_skipped check "$CHECK_RESULT"
          check_skipped repo-guards "$REPO_GUARDS_RESULT"
[% if project_type == 'web-app' %]
          check_skipped codegen-guard "$CODEGEN_GUARD_RESULT"
[% endif %]
[% if devcontainer %]
          check_skipped devcontainer-permissions "$DEVCONTAINER_PERMISSIONS_RESULT"
[% endif %]
          check_skipped security "$SECURITY_RESULT"
[% if use_node %]
          check_skipped build-test "$BUILD_TEST_RESULT"
          check_skipped e2e "$E2E_RESULT"
[% endif %]
[% if project_type == 'web-astro' %]
          check_skipped lighthouse "$LIGHTHOUSE_RESULT"
          check_skipped render-parity "$RENDER_PARITY_RESULT"
[% endif %]
          if [ "$fail" -ne 0 ]; then
            exit 1
          fi
          echo "Untrusted fork trust boundary enforced: all repository-controlled jobs were deliberately skipped."
      - if: env.IS_FORK != 'true'
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - name: Verify required jobs succeeded
        if: env.IS_FORK != 'true'
        env:
          EXPECTED_RESULT: success
          DOCS_ONLY_JOBS: "[% if project_type == 'web-app' %]codegen-guard [% endif %][% if devcontainer %]devcontainer-permissions [% endif %][% if use_node %]build-test e2e [% endif %][% if project_type == 'web-astro' %]lighthouse render-parity[% endif %]"
          CHECK_RESULT: ${{ needs.check.result }}
          REPO_GUARDS_RESULT: ${{ needs.repo-guards.result }}
[% if project_type == 'web-app' %]
          CODEGEN_GUARD_RESULT: ${{ needs.codegen-guard.result }}
[% endif %]
[% if devcontainer %]
          DEVCONTAINER_PERMISSIONS_RESULT: ${{ needs.devcontainer-permissions.result }}
[% endif %]
          SECURITY_RESULT: ${{ needs.security.result }}
[% if use_node %]
          BUILD_TEST_RESULT: ${{ needs.build-test.result }}
          E2E_RESULT: ${{ needs.e2e.result }}
[% endif %]
[% if project_type == 'web-astro' %]
          LIGHTHOUSE_RESULT: ${{ needs.lighthouse.result }}
          RENDER_PARITY_RESULT: ${{ needs.render-parity.result }}
[% endif %]
