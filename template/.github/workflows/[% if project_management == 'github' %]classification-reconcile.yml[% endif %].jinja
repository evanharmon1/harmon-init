name: Classification Reconcile
run-name: >-
  ${{ inputs.issue > 0 && format('reconciling the classification of issue #{0}', inputs.issue) || 'reconciling the classification of open issues' }}

# Materializes the derived Tier (`tier:<value>`) and `needs-triage` on open
# issues (ADR 2026-09-30 D4 "Reconcile drift" and D6; the Tier is a label on
# every owner type, ADR 2026-10-01). The logic is
# scripts/classification-reconcile.mjs; this file only wires triggers to it.
#
# Three ways in:
#   - schedule: daily on a personal-account repository, monthly on an
#     organization repository (Team-plan minutes are shared and most org
#     repositories are private). Walks this repository's open issues.
#   - workflow_call: classification-event.yml calls it for one issue. An
#     organization-level caller may also pass `repositories` plus the
#     CLASSIFICATION_TOKEN secret (a CI GitHub App installation token) to walk
#     every repository in the organization daily — the opt-in path in
#     docs/architecture/ci-cd.md. Without it the walk is limited to the calling
#     repository, because GITHUB_TOKEN is repository-scoped. On schedule and
#     workflow_dispatch the same expression reads a repository or organization
#     secret named CLASSIFICATION_TOKEN, so setting one is the opt-in there.
#   - workflow_dispatch: by hand, with an optional dry run.
#
# The checked-out repository supplies the script, the policy (.devflow.toml,
# whose [tier.matrix] cells govern), the reader, and label-registry.json.
#
# Writers: only `tier:<value>` and `needs-triage`, never over `tier:pinned`.
# Loop safety: label writes made with GITHUB_TOKEN start no workflow runs, and
# classification-event.yml never treats `tier:*` or `needs-triage` as an input.

on:
  schedule:
[% if github_org != author_git_provider_username %]
    # Monthly (the 1st): an organization repository. Team-plan minutes are
    # shared across the organization and most of its repositories are
    # private; the opt-in daily organization-level walk is in ci-cd.md.
    - cron: "37 6 1 * *"
[% else %]
    # Daily: a personal-account repository (public repositories run free).
    - cron: "37 6 * * *"
[% endif %]
  workflow_dispatch:
    inputs:
      repositories:
        description: "owner/name list to walk (default: this repository)"
        type: string
        required: false
        default: ""
      issue:
        description: "One issue number to reconcile (0 = every open issue)"
        type: number
        required: false
        default: 0
      dry-run:
        description: "Report the plan without writing any label"
        type: boolean
        required: false
        default: false
  workflow_call:
    inputs:
      repositories:
        description: "owner/name list to walk (default: the calling repository); needs the CLASSIFICATION_TOKEN secret beyond it"
        type: string
        required: false
        default: ""
      issue:
        description: "One issue number to reconcile (0 = every open issue)"
        type: number
        required: false
        default: 0
      dry-run:
        description: "Report the plan without writing any label"
        type: boolean
        required: false
        default: false
    secrets:
      CLASSIFICATION_TOKEN:
        description: "Optional cross-repository token (a CI GitHub App installation token with Issues: write); defaults to GITHUB_TOKEN"
        required: false

permissions:
  contents: read
  issues: write # tier:<value> and needs-triage labels only

jobs:
  reconcile:
    # Runner switch: CI_RUNS_ON repo/org variable unset -> the rendered
    # default; set it to a JSON runner spec to override without a commit.
    runs-on: ${{ fromJSON(vars.CI_RUNS_ON || '[[ ci_runs_on_default ]]') }}
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
        with:
          # renovate: datasource=node-version depName=node
          node-version: "24"
      - name: Reconcile Tier and needs-triage
        env:
          GH_TOKEN: ${{ secrets.CLASSIFICATION_TOKEN || github.token }}
          RECONCILE_REPOSITORIES: ${{ inputs.repositories }}
          RECONCILE_ISSUE: ${{ inputs.issue }}
          RECONCILE_DRY_RUN: ${{ inputs.dry-run }}
        run: node scripts/classification-reconcile.mjs
