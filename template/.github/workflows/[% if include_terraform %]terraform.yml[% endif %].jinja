name: Terraform
# Always emits terraform-verify so the ruleset can require it. A change detector
# makes unrelated changes a fast successful no-op. Pull requests and merge
# groups plan only; pushes and manual dispatches on main apply that exact saved
# plan, then prove state convergence.
#
# Credentialed plan/apply stays dormant until remote state exists: configure an
# S3-compatible backend with native locking (use_lockfile, Terraform >= 1.10),
# add R2_* backend credentials and provider TF_VAR_* secrets, then set the
# TERRAFORM_CI_ENABLED repo variable to 'true'.
on:
  push:
    branches: [main]
  pull_request:
    branches: [main]
  merge_group:
  workflow_dispatch:

# Never cancel an in-flight main apply. PR runs are plan-only and safe to
# supersede when a newer commit arrives.
concurrency:
  group: terraform-${{ github.ref }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

permissions:
  contents: read

jobs:
  changes:
    # Never execute pull-request-controlled repository code from a fork on a
    # potentially self-hosted runner. The aggregate handles this deliberate skip.
    if: >-
      github.event_name != 'pull_request' ||
      github.event.pull_request.head.repo.full_name == github.repository
    runs-on: ubuntu-latest
    outputs:
      terraform: ${{ steps.filter.outputs.changed }}
    steps:
      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6.0.3
        with:
          persist-credentials: false
          fetch-depth: 0
      - name: Detect Terraform-owned changes
        id: filter
        env:
          PR_BASE_SHA: ${{ github.event.pull_request.base.sha }}
          PR_HEAD_SHA: ${{ github.event.pull_request.head.sha }}
          MERGE_BASE_SHA: ${{ github.event.merge_group.base_sha }}
          MERGE_HEAD_SHA: ${{ github.event.merge_group.head_sha }}
          PUSH_BEFORE_SHA: ${{ github.event.before }}
        run: ./scripts/terraform-changed.sh >> "$GITHUB_OUTPUT"

  terraform-validate:
    needs: changes
    if: >-
      needs.changes.outputs.terraform == 'true' &&
      (github.event_name != 'pull_request' ||
       github.event.pull_request.head.repo.full_name == github.repository)
    runs-on: ${{ fromJSON(vars.CI_RUNS_ON || '[[ ci_runs_on_default ]]') }}
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6.0.3
        with:
          persist-credentials: false
      - uses: hashicorp/setup-terraform@dfe3c3f87815947d99a8997f908cb6525fc44e9e # v4.0.1
      - uses: arduino/setup-task@c0bc642852239c2689f73f4ea6459c29405f3c52 # v3.0.0
        with:
          # renovate: datasource=github-releases depName=go-task/task extractVersion=^v(?<version>.+)$
          version: 3.51.1
          repo-token: ${{ secrets.GITHUB_TOKEN }}
      - run: task lint:terraform
      - run: task terraform:validate

  terraform-plan-apply:
    needs: [changes, terraform-validate]
    if: >-
      needs.changes.outputs.terraform == 'true' &&
      vars.TERRAFORM_CI_ENABLED == 'true' &&
      (github.event_name != 'pull_request' ||
       github.event.pull_request.head.repo.full_name == github.repository)
    runs-on: ${{ fromJSON(vars.CI_RUNS_ON || '[[ ci_runs_on_default ]]') }}
    timeout-minutes: 15
    env:
      TF_CI_RUN_KEY: terraform-${{ github.repository_id }}-${{ github.run_id }}-${{ github.run_attempt }}
      # The S3-compatible backend (Cloudflare R2) reads AWS-style env vars.
      AWS_ACCESS_KEY_ID: ${{ secrets.R2_ACCESS_KEY_ID }}
      AWS_SECRET_ACCESS_KEY: ${{ secrets.R2_SECRET_ACCESS_KEY }}
      TF_IN_AUTOMATION: "true"
      # Add provider credentials as TF_VAR_* secrets here, e.g.:
      # TF_VAR_cloudflare_api_token: ${{ secrets.TF_VAR_CLOUDFLARE_API_TOKEN }}
      # TF_VAR_cloudflare_account_id: ${{ vars.CLOUDFLARE_ACCOUNT_ID }}
    steps:
      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6.0.3
        with:
          persist-credentials: false
      - uses: hashicorp/setup-terraform@dfe3c3f87815947d99a8997f908cb6525fc44e9e # v4.0.1
      - uses: arduino/setup-task@c0bc642852239c2689f73f4ea6459c29405f3c52 # v3.0.0
        with:
          # renovate: datasource=github-releases depName=go-task/task extractVersion=^v(?<version>.+)$
          version: 3.51.1
          repo-token: ${{ secrets.GITHUB_TOKEN }}
      - name: Terraform plan
        run: task terraform:ci:plan
      - name: Plan summary
        if: always()
        run: ./scripts/terraform-ci.sh summary
      # GitOps deploy-on-merge: the reviewed code is planned on the trusted main
      # event, and that exact generated artifact is applied without re-planning.
      - name: Terraform apply
        if: github.ref == 'refs/heads/main' && (github.event_name == 'push' || github.event_name == 'workflow_dispatch')
        run: task terraform:ci:apply
      - name: Converge check
        if: github.ref == 'refs/heads/main' && (github.event_name == 'push' || github.event_name == 'workflow_dispatch')
        run: task terraform:ci:converge
      - name: Clean Terraform CI artifacts
        if: always()
        run: ./scripts/terraform-ci.sh cleanup

  terraform-verify:
    if: always()
    needs: [changes, terraform-validate, terraform-plan-apply]
    runs-on: ubuntu-latest
    steps:
      - name: Check Terraform job results
        env:
          IS_FORK: ${{ github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name != github.repository }}
          TERRAFORM_CHANGED: ${{ needs.changes.outputs.terraform }}
          TERRAFORM_CI_ENABLED: ${{ vars.TERRAFORM_CI_ENABLED == 'true' }}
          CHANGES_RESULT: ${{ needs.changes.result }}
          VALIDATE_RESULT: ${{ needs.terraform-validate.result }}
          PLAN_RESULT: ${{ needs.terraform-plan-apply.result }}
        run: |
          expect() {
            if [ "$2" != "$3" ]; then
              echo "Job $1 result: $2 (expected $3)"
              return 1
            fi
          }

          fail=0
          if [ "$IS_FORK" = "true" ]; then
            expect changes "$CHANGES_RESULT" skipped || fail=1
            expect terraform-validate "$VALIDATE_RESULT" skipped || fail=1
            expect terraform-plan-apply "$PLAN_RESULT" skipped || fail=1
          else
            expect changes "$CHANGES_RESULT" success || fail=1
            case "$TERRAFORM_CHANGED" in
              true | false) ;;
              *)
                echo "Invalid Terraform change output: ${TERRAFORM_CHANGED:-<empty>}"
                fail=1
                ;;
            esac
            if [ "$TERRAFORM_CHANGED" = "true" ]; then
              expect terraform-validate "$VALIDATE_RESULT" success || fail=1
            else
              expect terraform-validate "$VALIDATE_RESULT" skipped || fail=1
            fi
            if [ "$TERRAFORM_CHANGED" = "true" ] && [ "$TERRAFORM_CI_ENABLED" = "true" ]; then
              expect terraform-plan-apply "$PLAN_RESULT" success || fail=1
            else
              expect terraform-plan-apply "$PLAN_RESULT" skipped || fail=1
            fi
          fi
          [ "$fail" -eq 0 ] || exit 1
          echo "Terraform checks passed or were deliberately not applicable."
