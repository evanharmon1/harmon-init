<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Create the [[ github_org ]]-ci GitHub App</title>
  </head>
  <body style="font-family: system-ui, sans-serif; max-width: 40rem; margin: 3rem auto; line-height: 1.5">
    <h1>Create the <code>[[ github_org ]]-ci</code> GitHub App</h1>
    <p>
      This opens GitHub's <strong>Create GitHub App</strong> page pre-filled with the
      exact permissions this repo's CI needs (it posts
      <code>.github/github-app-manifest.json</code> via GitHub's app-manifest flow).
      Review it, click <strong>Create GitHub App</strong>, then generate a private key
      and install the app on selected repositories. Full steps are in
      <code>docs/security.md</code>.
    </p>
    <p>
      <button id="create" style="font-size: 1rem; padding: 0.6rem 1rem; cursor: pointer">
        Create the [[ github_org ]]-ci app
      </button>
    </p>

    <!-- Keep this manifest identical to .github/github-app-manifest.json.
         redirect_url is required by GitHub's manifest flow and points at your
         own Apps page (same-origin github.com). After creation GitHub appends a
         short-lived single-use ?code=; it stays on github.com and expires
         unused. See docs/security.md "Manifest-flow note". -->
    <script id="manifest" type="application/json">
      {
        "name": "[[ github_org ]]-ci",
        "description": "CI automation app for [[ github_org ]]: mints short-lived tokens for release-please, Claude Code, and project automation. See docs/security.md.",
        "url": "[[ repo_url ]]",
        "redirect_url": "[% if github_org != author_git_provider_username %]https://github.com/organizations/[[ github_org ]]/settings/apps[% else %]https://github.com/settings/apps[% endif %]",
        "hook_attributes": { "url": "[[ repo_url ]]", "active": false },
        "public": false,
        "default_permissions": {
          "contents": "write",
          "pull_requests": "write",
          "issues": "write",
          "workflows": "write",
          "metadata": "read"[% if github_org != author_git_provider_username %],
          "actions": "read",
          "members": "read",
          "organization_projects": "write"[% endif %]
        }
      }
    </script>

    <script>
      // org-owned app for org repos, account-owned for personal repos
      var target =
        "[% if github_org != author_git_provider_username %]https://github.com/organizations/[[ github_org ]]/settings/apps/new[% else %]https://github.com/settings/apps/new[% endif %]";
      document.getElementById("create").addEventListener("click", function () {
        var manifest = JSON.stringify(
          JSON.parse(document.getElementById("manifest").textContent),
        );
        var form = document.createElement("form");
        form.method = "post";
        form.action = target;
        var input = document.createElement("input");
        input.type = "hidden";
        input.name = "manifest";
        input.value = manifest;
        form.appendChild(input);
        document.body.appendChild(form);
        form.submit();
      });
    </script>
  </body>
</html>
