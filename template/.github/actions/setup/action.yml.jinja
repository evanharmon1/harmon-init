name: Setup toolchain
description: >-
  Install the shared toolchain (Node[% if use_node %]/pnpm[% endif %], Python/uv[% if include_terraform %], Terraform[% endif %], Task)[% if use_node or use_python %], project
  dependencies,[% endif %] and — behind inputs — the lint + security CLIs. Single source of
  truth for the CI jobs and the Claude automation workflows so local, CI, and
  agent runs all execute the same Taskfile targets. Callers must run
  actions/checkout first.

inputs:
[% if use_node or use_python %]
  install-deps:
    description: Install project dependencies ([% if use_node %]pnpm install[% if use_python %], [% endif %][% endif %][% if use_python %]uv sync[% endif %]) when present.
    default: "true"
[% endif %]
  lint-tools:
    description: >-
      Install shellcheck, shfmt, actionlint, yamllint[% if use_skills_sync %], yq[% endif %] — required by
      `task check` / `task verify`.
    default: "false"
  gitleaks:
    description: Install gitleaks — required by `task security:secrets`.
    default: "false"
  snyk:
    description: Install the pinned Snyk CLI for an explicitly enabled scan.
    default: "false"
[% if use_node %]
  cache:
    description: >-
      Enable the pnpm dependency cache. Turn OFF for credential-holding jobs —
      the repo-wide Actions cache is writable from lower-trust PR runs, so a
      job with push/deploy tokens takes the cold-install trade instead.
    default: "true"
[% endif %]

runs:
  using: composite
  steps:
[% if use_node %]
    - uses: pnpm/action-setup@0ebf47130e4866e96fce0953f49152a61190b271 # v6.0.9
[% endif %]
    - uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7
      with:
        # renovate: datasource=node-version depName=node
        node-version: "24"
[% if use_node %]
        cache: ${{ inputs.cache == 'true' && 'pnpm' || '' }}
[% endif %]
    - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7
      with:
[% if use_python %]
        python-version: "3.14"
[% else %]
        python-version: "3.13"
[% endif %]
    # uv provides uvx for pinned Semgrep CE[% if use_foreman %] and the pinned
    # foreman CLI (see taskfiles/foreman.yml)[% endif %].
    - uses: astral-sh/setup-uv@20cfd1bf945f4377ade1205e4dbc17946fc9a30d # v10.0.1
[% if include_terraform %]
    - uses: hashicorp/setup-terraform@dfe3c3f87815947d99a8997f908cb6525fc44e9e # v4.0.1
    # TFLint backs `task lint:terraform` (via lint:terraform:tflint). The gate
    # job provisions nothing but this composite action, so without this step the
    # shared task gate would fail on the runner with "tflint: command not found".
    - uses: terraform-linters/setup-tflint@6e1e0642c0289bd619021bf6b34e3c08ed1e005a # v6.3.0
      with:
        # renovate: datasource=github-releases depName=terraform-linters/tflint
        tflint_version: v0.64.0
[% endif %]
    - uses: arduino/setup-task@c0bc642852239c2689f73f4ea6459c29405f3c52 # v3.0.0
      with:
        # renovate: datasource=github-releases depName=go-task/task extractVersion=^v(?<version>.+)$
        version: 3.51.1
        repo-token: ${{ github.token }}
    - name: Install lint tools (file, shellcheck, shfmt, actionlint, yamllint[% if use_skills_sync %], yq[% endif %])
      if: inputs.lint-tools == 'true'
      shell: bash
      run: |
        # `file` backs lint-hygiene.sh's binary detection, which fails closed
        # rather than silently scanning binaries as text. GitHub-hosted images
        # ship it, but a self-hosted CI_RUNS_ON runner may not. The helper
        # probes for a package manager rather than assuming apt-get.
        ./scripts/ensure-file.sh
        # renovate: datasource=github-releases depName=koalaman/shellcheck extractVersion=^v(?<version>.+)$
        SHELLCHECK_VERSION=0.11.0
        # renovate: datasource=github-releases depName=mvdan/sh extractVersion=^v?(?<version>.+)$
        SHFMT_VERSION=3.14.1 # pin-pair: shfmt
        # renovate: datasource=github-releases depName=rhysd/actionlint extractVersion=^v?(?<version>.+)$
        ACTIONLINT_VERSION=1.7.12
        # renovate: datasource=pypi depName=yamllint
        YAMLLINT_VERSION=1.38.0
[% if use_skills_sync %]
        # renovate: datasource=github-releases depName=mikefarah/yq extractVersion=^v?(?<version>.+)$
        YQ_VERSION=4.53.6 # pin-pair: yq
[% endif %]

        # Each `*_sha256` is Renovate-managed with its `*_VERSION`: the
        # github-release-attachments annotation above it names the release tag
        # the hash belongs to, and Renovate rewrites tag and hash together when
        # it bumps the version. `# pin-pair:` marks the lines that must move
        # together; scripts/test-tool-pin-pairs.sh (`task check`) fails a bump
        # that left one behind.
        runner_arch="${RUNNER_ARCH:-$(uname -m)}"
        case "$runner_arch" in
          X64|x86_64)
            shellcheck_arch=x86_64
            shfmt_arch=amd64
            # renovate: datasource=github-release-attachments depName=mvdan/sh digestVersion=v3.14.1
            shfmt_sha256=76e77641faa025814b77f153b29796b8e6fa2fca03e0c76a691608b86c7ea7bf # pin-pair: shfmt
            actionlint_arch=amd64
[% if use_skills_sync %]
            yq_arch=amd64
            # renovate: datasource=github-release-attachments depName=mikefarah/yq digestVersion=v4.53.6
            yq_sha256=c5f056448f973ae7d39b5401949648a78f2dc1947d6a8eb65be60d5c504b9385 # pin-pair: yq
[% endif %]
            ;;
          ARM64|arm64|aarch64)
            shellcheck_arch=aarch64
            shfmt_arch=arm64
            # renovate: datasource=github-release-attachments depName=mvdan/sh digestVersion=v3.14.1
            shfmt_sha256=5f2db09dae91fca848f7adbdd014632e921a383863a2ad7e0450ad3aba0c6489 # pin-pair: shfmt
            actionlint_arch=arm64
[% if use_skills_sync %]
            yq_arch=arm64
            # renovate: datasource=github-release-attachments depName=mikefarah/yq digestVersion=v4.53.6
            yq_sha256=88a1016bc1d657375a35864e4f44b6f333df8ff97b559f51bba0adcb2169df09 # pin-pair: yq
[% endif %]
            ;;
          *)
            echo "::error::Unsupported runner architecture for pinned lint tools: ${runner_arch}" >&2
            exit 1
            ;;
        esac

        : "${RUNNER_TEMP:?RUNNER_TEMP is required for job-private lint tools}"
        : "${GITHUB_PATH:?GITHUB_PATH is required to publish pinned lint tools}"
        lint_tools_bin="${RUNNER_TEMP}/harmon-init-lint-tools/${SHELLCHECK_VERSION}-${SHFMT_VERSION}-${ACTIONLINT_VERSION}-${YAMLLINT_VERSION}/${runner_arch}"
        mkdir -p "$lint_tools_bin"
        printf '%s\n' "$lint_tools_bin" >> "$GITHUB_PATH"
        export PATH="${lint_tools_bin}:${PATH}"
        lint_tools_tmp="$(mktemp -d "${RUNNER_TEMP}/harmon-init-lint-tools-download.XXXXXX")"
        trap 'rm -rf "$lint_tools_tmp"' EXIT

        installed_shellcheck_version=
        while IFS= read -r line; do
          case "$line" in
            "version: "*) installed_shellcheck_version="${line#version: }"; break ;;
          esac
        done <<<"$(shellcheck --version 2>/dev/null || true)"
        if [ "$installed_shellcheck_version" != "$SHELLCHECK_VERSION" ]; then
          curl -fsSL --retry 3 -o "${lint_tools_tmp}/shellcheck.tar.xz" \
            "https://github.com/koalaman/shellcheck/releases/download/v${SHELLCHECK_VERSION}/shellcheck-v${SHELLCHECK_VERSION}.linux.${shellcheck_arch}.tar.xz"
          tar -xJf "${lint_tools_tmp}/shellcheck.tar.xz" -C "$lint_tools_tmp"
          install -m 0755 "${lint_tools_tmp}/shellcheck-v${SHELLCHECK_VERSION}/shellcheck" "${lint_tools_bin}/shellcheck"
        fi
        installed_shfmt_version=
        IFS= read -r installed_shfmt_version <<<"$(shfmt --version 2>/dev/null || true)"
        installed_shfmt_version="${installed_shfmt_version#v}"
        if [ "$installed_shfmt_version" != "$SHFMT_VERSION" ]; then
          # Raw-binary download: fail closed on a checksum mismatch. Archive
          # downloads (shellcheck, actionlint) already fail loudly at extract
          # time on corruption; a hash-pinned toolchain image is the follow-on
          # refactor.
          curl -fsSL --retry 3 -o "${lint_tools_tmp}/shfmt" \
            "https://github.com/mvdan/sh/releases/download/v${SHFMT_VERSION}/shfmt_v${SHFMT_VERSION}_linux_${shfmt_arch}"
          echo "${shfmt_sha256}  ${lint_tools_tmp}/shfmt" | sha256sum -c -
          install -m 0755 "${lint_tools_tmp}/shfmt" "${lint_tools_bin}/shfmt"
        fi
        installed_actionlint_version=
        IFS= read -r installed_actionlint_version <<<"$(actionlint --version 2>/dev/null || true)"
        installed_actionlint_version="${installed_actionlint_version#v}"
        if [ "$installed_actionlint_version" != "$ACTIONLINT_VERSION" ]; then
          curl -fsSL --retry 3 -o "${lint_tools_tmp}/actionlint.tar.gz" \
            "https://github.com/rhysd/actionlint/releases/download/v${ACTIONLINT_VERSION}/actionlint_${ACTIONLINT_VERSION}_linux_${actionlint_arch}.tar.gz"
          tar -xzf "${lint_tools_tmp}/actionlint.tar.gz" -C "$lint_tools_tmp" actionlint
          install -m 0755 "${lint_tools_tmp}/actionlint" "${lint_tools_bin}/actionlint"
        fi
[% if use_skills_sync %]
        installed_yq_version=
        IFS= read -r installed_yq_version <<<"$(yq --version 2>/dev/null || true)"
        installed_yq_version="${installed_yq_version##* version v}"
        if [ "$installed_yq_version" != "$YQ_VERSION" ]; then
          # Raw-binary download: fail closed on a checksum mismatch.
          curl -fsSL --retry 3 -o "${lint_tools_tmp}/yq" \
            "https://github.com/mikefarah/yq/releases/download/v${YQ_VERSION}/yq_linux_${yq_arch}"
          echo "${yq_sha256}  ${lint_tools_tmp}/yq" | sha256sum -c -
          install -m 0755 "${lint_tools_tmp}/yq" "${lint_tools_bin}/yq"
        fi
[% endif %]
        installed_yamllint_version=
        IFS= read -r installed_yamllint_version <<<"$(yamllint --version 2>/dev/null || true)"
        installed_yamllint_version="${installed_yamllint_version#yamllint }"
        if [ "$installed_yamllint_version" != "$YAMLLINT_VERSION" ]; then
          yamllint_venv="${RUNNER_TEMP}/harmon-init-lint-tools/yamllint-${YAMLLINT_VERSION}"
          python3 -m venv "$yamllint_venv"
          "${yamllint_venv}/bin/python" -m pip install --disable-pip-version-check \
            "yamllint==${YAMLLINT_VERSION}"
          ln -sfn "${yamllint_venv}/bin/yamllint" "${lint_tools_bin}/yamllint"
        fi
    - name: Install gitleaks
      if: inputs.gitleaks == 'true'
      shell: bash
      run: |
        # renovate: datasource=github-releases depName=gitleaks/gitleaks extractVersion=^v?(?<version>.+)$
        GITLEAKS_VERSION=8.24.3 # pin-pair: gitleaks
        # A pre-installed gitleaks (a self-hosted or pre-baked runner) is only
        # reused when its version matches the pin exactly — otherwise the
        # runner silently ran whatever version happened to be on it. The
        # trailing "|| true" matters: GitHub's `shell: bash` steps always run
        # `bash -eo pipefail`, so a PRESENT but non-executing binary (a
        # corrupted download, wrong arch, missing shared library) would
        # otherwise abort this entire step instead of being treated as a
        # mismatch and replaced — worse than the version check this fix
        # exists to add.
        installed_gitleaks_version=
        if command -v gitleaks >/dev/null 2>&1; then
          # The whole reported token (not a regex-extracted semver-shaped
          # substring of it) so that build metadata or an adjacent suffix
          # with no separator (8.24.3+vendor.1, 8.24.3rc1) is preserved and
          # fails the exact comparison below, instead of being silently
          # trimmed off and accepted as matching the pin.
          installed_gitleaks_version="$(gitleaks version 2>/dev/null | head -n1 | tr -d '[:space:]')" || true
          installed_gitleaks_version="${installed_gitleaks_version#v}"
        fi
        if [ "$installed_gitleaks_version" != "$GITLEAKS_VERSION" ]; then
          runner_arch="${RUNNER_ARCH:-$(uname -m)}"
          case "$runner_arch" in
            X64|x86_64)
              gitleaks_arch=x64
              # renovate: datasource=github-release-attachments depName=gitleaks/gitleaks digestVersion=v8.24.3
              gitleaks_sha256=9991e0b2903da4c8f6122b5c3186448b927a5da4deef1fe45271c3793f4ee29c # pin-pair: gitleaks
              ;;
            ARM64|arm64|aarch64)
              gitleaks_arch=arm64
              # renovate: datasource=github-release-attachments depName=gitleaks/gitleaks digestVersion=v8.24.3
              gitleaks_sha256=5f2edbe1f49f7b920f9e06e90759947d3c5dfc16f752fb93aaafc17e9d14cf07 # pin-pair: gitleaks
              ;;
            *)
              echo "::error::Unsupported runner architecture for pinned gitleaks: ${runner_arch}" >&2
              exit 1
              ;;
          esac
          # Install into a job-scoped directory and PREPEND it via
          # GITHUB_PATH, rather than /usr/local/bin: on a self-hosted
          # runner, a stale gitleaks earlier on PATH than /usr/local/bin
          # would otherwise keep winning command resolution even after the
          # pinned binary lands on disk. The archive is verified against the
          # per-architecture `gitleaks_sha256` above before it is extracted.
          : "${RUNNER_TEMP:?RUNNER_TEMP is required for the job-private gitleaks install}"
          : "${GITHUB_PATH:?GITHUB_PATH is required to publish the pinned gitleaks}"
          gitleaks_bin="${RUNNER_TEMP}/harmon-init-gitleaks/${GITLEAKS_VERSION}"
          mkdir -p "$gitleaks_bin"
          curl -fsSL --retry 3 -o "${RUNNER_TEMP}/gitleaks.tgz" \
            "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_${gitleaks_arch}.tar.gz"
          echo "${gitleaks_sha256}  ${RUNNER_TEMP}/gitleaks.tgz" | sha256sum -c -
          tar -xzf "${RUNNER_TEMP}/gitleaks.tgz" -C "$gitleaks_bin" gitleaks
          printf '%s\n' "$gitleaks_bin" >> "$GITHUB_PATH"
          export PATH="${gitleaks_bin}:${PATH}"
        fi
    - name: Install Snyk CLI
      if: inputs.snyk == 'true'
      shell: bash
      run: |
        # renovate: datasource=npm depName=snyk
        SNYK_VERSION=1.1305.2
        # Same reuse-only-on-exact-match reasoning, and the same "|| true"
        # abort-under-set-e reasoning, as gitleaks above.
        installed_snyk_version=
        if command -v snyk >/dev/null 2>&1; then
          # Same reasoning as the gitleaks check above: the whole token,
          # not a regex-extracted subset of it.
          installed_snyk_version="$(snyk --version 2>/dev/null | head -n1 | tr -d '[:space:]')" || true
          installed_snyk_version="${installed_snyk_version#v}"
        fi
        if [ "$installed_snyk_version" != "$SNYK_VERSION" ]; then
          # Same job-scoped-directory + GITHUB_PATH-prepend reasoning as
          # gitleaks above: `npm install --global` alone does not change
          # PATH order, so a stale snyk earlier on PATH than npm's global
          # bin directory would otherwise keep winning resolution.
          : "${RUNNER_TEMP:?RUNNER_TEMP is required for the job-private Snyk install}"
          : "${GITHUB_PATH:?GITHUB_PATH is required to publish the pinned Snyk CLI}"
          snyk_install_dir="${RUNNER_TEMP}/harmon-init-snyk/${SNYK_VERSION}"
          mkdir -p "$snyk_install_dir"
          npm install --global --prefix "$snyk_install_dir" "snyk@${SNYK_VERSION}"
          printf '%s\n' "${snyk_install_dir}/bin" >> "$GITHUB_PATH"
          export PATH="${snyk_install_dir}/bin:${PATH}"
        fi
[% if use_python %]
    - name: Install Python dependencies
      if: inputs.install-deps == 'true'
      shell: bash
      run: |
        if [ -f uv.lock ]; then
          uv sync --locked
        else
          uv sync
        fi
[% endif %]
[% if use_node %]
    - name: Install dependencies
      if: inputs.install-deps == 'true'
      shell: bash
      # A Cloudflare Workers project's wrangler pulls sharp in deeply enough
      # that pnpm treats a failed sharp build as fatal. sharp's installer
      # prefers a runner's global libvips over its own bundled prebuilt when
      # one is on PKG_CONFIG_PATH (a self-hosted runner image can carry
      # one), and that from-source build then fails without node-addon-api.
      # Harmless when sharp isn't installed at all.
      env:
        SHARP_IGNORE_GLOBAL_LIBVIPS: "1"
      run: |
        if [ -f package.json ]; then pnpm install --frozen-lockfile; fi
[% endif %]
