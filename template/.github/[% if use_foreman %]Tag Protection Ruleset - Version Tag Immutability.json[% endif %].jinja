{
  "name": "Version Tag Immutability",
  "target": "tag",
  "source_type": "Repository",
  "source": "[[ github_org ]]/[[ project_slug ]]",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["refs/tags/v*"],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "update"
    },
    {
      "type": "deletion"
    }
  ],
  "bypass_actors": []
}
