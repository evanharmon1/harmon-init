# Example environment file for Terraform secrets/vars. Copy to `tfvars.env`
# (gitignored) and fill in real values — ideally sourced from 1Password
# (e.g. `op inject -i tfvars.env.example -o tfvars.env`).
#
# Load before running terraform, e.g. with direnv (.envrc) or `set -a; . ./tfvars.env; set +a`.

# TF_VAR_environment=dev
# TODO: add TF_VAR_<name> entries for the sensitive variables in variables.tf.
# TF_VAR_cloudflare_api_token=TODO_set_via_1password
