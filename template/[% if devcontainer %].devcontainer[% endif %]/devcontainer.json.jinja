{
  // Primary profile for AI agents (Claude Code, Codex, Gemini, OpenCode).
  // Secrets (GH_TOKEN) come from the --env-file, not containerEnv.
  // Tailscale is not installed in this profile — see dev/ for the human profile.
  "name": "BOT - devcontainer-[[ project_slug ]]",
  "containerName": "devcontainer-[[ project_slug ]]-bot",
  // Minimum to run the intended workload (Playwright + agents). Codespaces
  // enforces it; local Docker / Coder may not — see
  // docs/guides/devcontainer-performance.md for recommended sizing.
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb"
  },
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "cacheFrom": "[[ devcontainer_image ]]"
  },
  // Bot profile intentionally omits TS_AUTHKEY from the allow-list — this
  // container has no Tailscale feature installed, and we don't want a tailnet
  // auth key sitting in its env-file. init-env.sh will strip any stale
  // TS_AUTHKEY entry on every rebuild.
  // Alternative-model provider keys (KIMI/DEEPSEEK/ZAI) are opt-in via
  // use_alternative_claude_providers; when on they land in this env-file too,
  // so a headless/bypass bot can read them — a deliberate posture extension.
  "initializeCommand": "bash .devcontainer/scripts/init-env.sh .devcontainer/devcontainer.env GH_TOKEN[% if use_foreman %] FOREMAN_AGENT_GH_TOKEN[% endif %] CLAUDE_CODE_OAUTH_TOKEN AGENT_DECK_TELEGRAM_KEY[% if use_alternative_claude_providers %] KIMI_API_KEY MOONSHOT_API_KEY DEEPSEEK_API_KEY ZAI_API_KEY QWEN_API_KEY[% endif %]",
  "runArgs": [
    "--init",
    "--shm-size=2g",
[% if use_alternative_claude_providers %]
    // Linux hosts don't resolve host.docker.internal by default (unlike Docker
    // Desktop on mac/win/WSL2); this mapping makes it resolve everywhere,
    // which claude-qwen-local() (.devcontainer/config/claude-providers.sh)
    // relies on to reach an Ollama/LM Studio endpoint on the host. Supported
    // since Docker 20.10, harmless where the platform already resolves it.
    "--add-host=host.docker.internal:host-gateway",
[% endif %]
    "--env-file",
    ".devcontainer/devcontainer.env"
  ],
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.14"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "dockerDashComposeVersion": "v2"
    },
    // No 1Password CLI in the bot profile — this container must hold no path
    // to production secrets (docs/guides/devcontainers.md). The human dev
    // profile (.devcontainer/dev/) keeps its own op feature.
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "mounts": [
    [% if use_python %]
    // Mask the bind-mounted .venv with a container-private volume: the
    // container's `uv sync` must never rewrite the host's venv in place
    // (Linux binaries + /workspaces shebangs break every host-side run).
    "source=venv-[[ github_org ]]-[[ project_slug ]],target=${containerWorkspaceFolder}/.venv,type=volume",
    [% endif %]
    "source=claude-code-config-[[ github_org ]]-[[ project_slug ]],target=/home/vscode/.claude,type=volume",
    "source=codex-config-[[ github_org ]]-[[ project_slug ]],target=/home/vscode/.codex,type=volume",
    "source=gemini-config-[[ github_org ]]-[[ project_slug ]],target=/home/vscode/.gemini,type=volume",
    "source=agent-deck-config-[[ github_org ]]-[[ project_slug ]],target=/home/vscode/.agent-deck,type=volume",
    "source=herdr-config-[[ github_org ]]-[[ project_slug ]],target=/home/vscode/.config/herdr,type=volume",
    "source=opencode-config-[[ github_org ]]-[[ project_slug ]],target=/home/vscode/.config/opencode,type=volume",
    "source=opencode-data-[[ github_org ]]-[[ project_slug ]],target=/home/vscode/.local/share/opencode,type=volume",
    "source=shell-history-[[ github_org ]]-[[ project_slug ]],target=/home/vscode/.shell-history,type=volume",
    "source=zoxide-data-[[ github_org ]]-[[ project_slug ]],target=/home/vscode/.local/share/zoxide,type=volume"
  ],
  // Secrets (GH_TOKEN) are populated into the --env-file by init-env.sh
  // (from 1Password locally, or from host env on Coder/Codespaces).
  // Do NOT forward them via containerEnv — ${localEnv:...} resolves to ""
  // when the host shell doesn't export them, which overrides the env-file
  // values (Docker --env takes precedence over --env-file).
  //
  // FOREMAN_DEVCONTAINER: foreman's D2 startup tripwire — it refuses to run
  // anywhere this marker is not "bot" (only the bot profile sets it).
  "containerEnv": {
    "CODER": "${localEnv:CODER}",
[% if use_antigravity_cli %]
    "AGY_CLI_DISABLE_AUTO_UPDATE": "true",
[% endif %]
    "FOREMAN_DEVCONTAINER": "bot"
  },
[% if include_ansible %]
  "remoteEnv": {
    "ANSIBLE_CONFIG": "${containerWorkspaceFolder}/ansible/ansible.cfg"
  },
[% endif %]
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",
  "customizations": {
    "coder": {
      "name": "devcontainer"
    },
    "vscode": {
      "settings": {
        "terminal.integrated.inheritEnv": true,
        "python.defaultInterpreterPath": ".venv/bin/python",
        "[python]": {
          "editor.defaultFormatter": "ms-python.black-formatter"
        },
        "debug.javascript.autoAttachFilter": "disabled",
        "terminal.integrated.env.linux": {
          "NODE_OPTIONS": "",
          "BROWSER": ""
        },
        "remote.autoForwardPortsSource": "output",
        "terminal.integrated.minimumContrastRatio": 1,
        "terminal.integrated.defaultProfile.linux": "zsh",
        "extensions.ignoreRecommendations": false
      },
      "extensions": [
[% if include_terraform %]
        "hashicorp.terraform",
[% endif %]
[% if include_ansible %]
        "redhat.ansible",
[% endif %]
        "ms-azuretools.vscode-docker",
        "ms-python.python",
        "ms-python.black-formatter",
[% if project_type in ['web-astro', 'web-app'] %]
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss",
[% endif %]
[% if project_type == 'web-astro' %]
        "astro-build.astro-vscode",
        "unifiedjs.vscode-mdx",
[% endif %]
        "esbenp.prettier-vscode",
        "timonwong.shellcheck",
        "redhat.vscode-yaml",
        "tamasfe.even-better-toml",
        "mikestead.dotenv",
        "davidanson.vscode-markdownlint",
        "foxundermoon.shell-format",
        "GitHub.vscode-github-actions",
        "github.vscode-pull-request-github",
        "task.vscode-task",
        "EditorConfig.EditorConfig",
        "anthropic.claude-code",
        "openai.chatgpt",
        "ms-playwright.playwright"
      ]
    }
  },
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "forwardPorts": [
[% if use_node %]
    4321,
[% endif %]
    8420
  ],
  "portsAttributes": {
[% if use_node %]
    "4321": {
      "label": "Astro Dev Server",
      "onAutoForward": "notify"
    },
[% endif %]
    "8420": {
      "label": "Agent Deck Web UI",
      "onAutoForward": "notify"
    }
  }
}
