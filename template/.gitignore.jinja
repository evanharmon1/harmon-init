# build output
dist/
.output/
.astro/

# dependencies
.pnpm-store/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Playwright
test-results/
playwright-report/
.playwright-cli/

# coverage / test output
coverage/
.nyc_output/
