[% if use_python %]

# Python
.venv/
__pycache__/
*.pyc

# Python caches / coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# direnv: resolved secret exports, generated from .envrc.tpl via `op inject`
