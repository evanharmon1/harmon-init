[project]
name = "[[ project_slug ]]"
version = "0.1.0"
description = "[[ project_description ]]"
readme = "README.md"
requires-python = ">=3.14"
dependencies = []

[dependency-groups]
dev = [
    "black>=24.0.0",
[% if include_ansible %]
    "ansible-lint>=26.3.0",
    "ansible-core>=2.18",
[% endif %]
]

[tool.black]
# `requires-python = ">=3.14"` has no upper bound, so Black may otherwise infer
# a future grammar (for example py315) that the active 3.14 runtime cannot parse.
target-version = ["py314"]
