# Foreman configuration for [[ project_name ]] (docs/architecture/foreman.md).
#
# Issue custom fields are org-only: on an org-owned repo `inputs = "auto"`
# resolves to fields mode (`foreman`, `foreman-budget-usd`,
# `foreman-timeout-min`); on a personal-account repo it falls back to labels
# (`foreman:claude`, `foreman:hold`, ...). Explicit approval is required
# before any issue is dispatchable.

backend = "claude"
require_approval = true
require_codex_cloud_review = [[ 'true' if use_codex_cloud_review else 'false' ]]
inputs = "auto"
[% if use_node %]
# `task ci` includes the port-binding `test:e2e` tier, while `task verify` is
# port-free by design (docs/architecture/tests.md). With max_parallel > 1 that
# matters only once this app ships a playwright.config.* — before then test:e2e
# skips, so nothing binds a port. When you add the e2e suite, pick one: point
# verify_command at ["task", "verify"], drop max_parallel to 1, or give the
# Playwright config a per-worktree port.
[% endif %]
verify_command = ["task", "ci"]
max_parallel = 3
branch_prefix = "foreman"
expected_login = "[[ author_git_provider_username ]]-bot"

# Only these GitHub logins, trusted author associations, and Foreman's own
# account may contribute unresolved review-thread content to agent prompts.
review_sender_trust = [[ '["coderabbitai", "Copilot"]' if use_coderabbit else '["Copilot"]' ]]

# Bots whose review of the CURRENT head the readiness gate waits for before
# promoting a draft. Deliberately separate from review_sender_trust: that list
# says whose findings are safe to quote, not who is expected to post, so waiting
# on it would stall on a bot that never reviews. Naming a bot here makes its
# silence blocking rather than reading an empty thread list as "nothing found".
[% if use_coderabbit %]# CodeRabbit reviews drafts (reviews.auto_review.drafts: true), so its verdict
# is available before promotion — wait for it. Spelled with the `[bot]` suffix
# because this list is matched against REST review authors, where an App is
# `coderabbitai[bot]`; review_sender_trust above is matched against GraphQL
# logins, where the same actor is plain `coderabbitai`. Foreman normalises the
# suffix away, so either spelling works — but keep them accurate to their API.
required_review_bots = ["coderabbitai[bot]"][% else %]required_review_bots = []
# Add a bot's login here once one that reviews drafts is installed.[% endif %]

# subscription (default): adapters inherit CLAUDE_CODE_OAUTH_TOKEN; USD
# budgets are inert (guardrails bind on timeout/turns). api: adapters export
# FOREMAN_ANTHROPIC_API_KEY process-locally; USD budgets bind.
billing = "subscription"

# Set FOREMAN_SANDBOXED=1 (env) inside the egress-limited bot devcontainer to
# let adapters run with a relaxed permission mode; the committed default stays
# conservative for any other host.
sandboxed = false

[budgets]
dispatch_usd = 20.0
shepherd_usd = 10.0

[timeouts]
dispatch_min = 90
shepherd_min = 30
