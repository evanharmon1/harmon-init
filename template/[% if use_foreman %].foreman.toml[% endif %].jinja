# Foreman configuration for [[ project_name ]] — read by the pinned Foreman
# CLI (taskfiles/foreman.yml; https://github.com/ponderousdev/foreman).
#
# Issue custom fields are org-only: on an org-owned repo `inputs = "auto"`
# resolves to fields mode (`foreman`, `foreman-budget-usd`,
# `foreman-timeout-min`); on a personal-account repo it falls back to labels
# (`foreman:claude`, `foreman:hold`, ...). Explicit approval is required
# before any issue is dispatchable.

# Where units execute: local (v2.0) | sprite (v2.1) | docker (v2.2).
runner = "local"
backend = "claude"
require_approval = true
inputs = "auto"
max_parallel = 3
branch_prefix = "foreman"
# Identity asserted before any write.
expected_login = "[[ author_git_provider_username ]]-bot"

# Accounts (humans and apps) whose content and arming events are trusted:
# who may arm an issue, and whose review/comment content may be embedded in
# agent prompts. Empty = nobody is trusted (fail closed). App accounts are
# spelled with the `[bot]` suffix.
trusted_actors = [[ '["' + author_git_provider_username + '", "' + author_git_provider_username + '-bot", "Copilot", "coderabbitai[bot]"]' if use_coderabbit else '["' + author_git_provider_username + '", "' + author_git_provider_username + '-bot", "Copilot"]' ]]

# Hard capability requirements: the baseline gate cannot run without these;
# a mismatch is refused before dispatch.
required_capabilities = []

# subscription (default): adapters inherit CLAUDE_CODE_OAUTH_TOKEN; USD
# budgets are inert (guardrails bind on timeout/turns). api: adapters export
# FOREMAN_ANTHROPIC_API_KEY process-locally; USD budgets bind.
billing = "subscription"

# Set FOREMAN_SANDBOXED=1 (env) inside the egress-limited bot devcontainer to
# let adapters run with a relaxed permission mode; the committed default stays
# conservative for any other host.
sandboxed = false

# NOTE: [verify] must stay below every top-level key — in TOML, keys after a
# section header belong to that section until the next header.
#
# The composed verify gate: `default` runs in every unit; capability-keyed
# entries (docker, ports, untrusted-input) run additionally where the
# capability is present. Whatever does not run in-unit is CI's job.
[% if use_node %]
# `task ci` includes the port-binding `test:e2e` tier, while `task verify` is
# port-free by design (docs/architecture/tests.md). With max_parallel > 1 that
# matters only once this app ships a playwright.config.* — before then test:e2e
# skips, so nothing binds a port. When you add the e2e suite, pick one: point
# [verify] default at ["task", "verify"], drop max_parallel to 1, or give the
# Playwright config a per-worktree port.
[% endif %]
[verify]
default = ["task", "ci"]

[budgets]
dispatch_usd = 20.0
shepherd_usd = 10.0

[timeouts]
dispatch_min = 90
shepherd_min = 30
