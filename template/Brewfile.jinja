# Brewfile for [[ project_name ]]
# Install with: task install  (brew bundle --file=Brewfile)

# Task runner + git hooks
brew "go-task"
brew "lefthook"

# Git / GitHub
brew "git"
brew "gh"
brew "git-delta"

# Lint / format
brew "shellcheck"
brew "shfmt"
brew "actionlint"
brew "yamllint"

# Security
brew "gitleaks"
tap "snyk/tap"
brew "snyk/tap/snyk"

# Runtime for npx-based tools (commitlint, markdownlint-cli2)
brew "node"
[% if use_node %]
brew "pnpm"
brew "lychee"
[% endif %]
[% if use_python %]

# Python tooling
brew "uv"
[% endif %]
[% if include_terraform %]

# Terraform
brew "terraform"
[% endif %]
[% if devcontainer %]

# Devcontainer
brew "hadolint"
[% endif %]
[% if use_skills_sync %]

# Skills sync (scripts/sync-skills.sh reads .skills-sync.yaml)
brew "yq"
[% endif %]

# Utilities
brew "direnv"
brew "jq"
brew "fzf"
brew "fd"
brew "ripgrep"
brew "bat"
brew "tokei"
brew "gum"          # status dashboard rendering (scripts/status.sh)
brew "television"   # interactive task menu (`task` / task menu-tv → tv)
[% if bunch_add %]

# macOS apps
cask "bunch"
[% endif %]
