{
[% if use_codex_review %]
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "enabledPlugins": {
    "codex@openai-codex": true
  },
[% endif %]
  "permissions": {
    "allow": [
      "Bash(task:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(gh pr merge)",
      "Bash(gh pr merge:*)",
      "Bash(git merge)",
      "Bash(git merge:*)",
      "Bash(git push origin main)",
      "Bash(git push origin main:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force:*)"
    ]
  }
}
