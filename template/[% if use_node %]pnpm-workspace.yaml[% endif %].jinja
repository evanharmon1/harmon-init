# pnpm build-script approvals + version pins. pnpm 10+ blocks dependency build
# scripts by default. `allowBuilds` (a map) is the pnpm 11+ approval setting —
# it replaced pnpm 10's `onlyBuiltDependencies` list, so this file requires
# pnpm 11+. List the packages whose build scripts must run here (NOT the
# package.json `pnpm` field — pnpm 10+ ignores that).
allowBuilds:
  esbuild: true
[% if project_type == 'web-app' %]
  # sharp is an optional transitive dep of tooling (e.g. wrangler) that web-app
  # code never imports; its from-source build fails on current Node and is
  # unnecessary (prebuilt binaries ship as optional deps). Explicit false =
  # "do not run its build script".
  sharp: false
[% else %]
  sharp: true
[% endif %]
[% if deploy_cloudflare_workers %]
  # workerd (the Cloudflare Workers runtime) is pulled in by wrangler at deploy
  # time; approve its build or `wrangler deploy` fails ERR_PNPM_IGNORED_BUILDS.
  workerd: true
[% endif %]

overrides:
  # --- harmon-init security floors (template-owned; updated by copier update) ---
  # A 0.x minor is the semver breaking boundary. These entries move only the
  # Astro/Vite/wrangler graph's esbuild 0.27→0.28 and sharp 0.34→0.35 minors
  # because upstream published no in-minor patch. Vite 8.3.4 declares
  # ^0.27.0 || ^0.28.0 for esbuild; miniflare pins sharp 0.34.
  # The fixture toolchain builds with the moved versions. Other 0.x minor
  # edges are left alone and show up in the consumer's audit for a local floor
  # after validating. Esbuild's advisory covers dev-server file reads on Windows.
  # esbuild@0.27: GHSA-gv7w-rqvm-qjhr.
  esbuild@0.27: '>=0.28.1 <0.29'
  # esbuild@0.28: GHSA-gv7w-rqvm-qjhr.
  esbuild@0.28: '>=0.28.1 <0.29'
  # sharp@0.34: GHSA-wq5f-xc86-pv6w, GHSA-rgj7-g3m4-5g8c, GHSA-f88m-g3jw-g9cj.
  sharp@0.34: '>=0.35.5 <0.36'
  # sharp@0.35: GHSA-wq5f-xc86-pv6w, GHSA-rgj7-g3m4-5g8c, GHSA-f88m-g3jw-g9cj.
  sharp@0.35: '>=0.35.5 <0.36'
