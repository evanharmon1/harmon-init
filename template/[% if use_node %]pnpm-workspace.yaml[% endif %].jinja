# pnpm build-script approvals + version pins. pnpm 10+ blocks dependency build
# scripts by default. `allowBuilds` (a map) is the pnpm 11+ approval setting —
# it replaced pnpm 10's `onlyBuiltDependencies` list, so this file requires
# pnpm 11+. List the packages whose build scripts must run here (NOT the
# package.json `pnpm` field — pnpm 10+ ignores that).
allowBuilds:
  esbuild: true
[% if project_type == 'web-app' %]
  # sharp is an optional transitive dep of tooling (e.g. wrangler) that web-app
  # code never imports; its from-source build fails on current Node and is
  # unnecessary (prebuilt binaries ship as optional deps). Explicit false =
  # "do not run its build script".
  sharp: false
[% else %]
  sharp: true
[% endif %]
[% if deploy_cloudflare_workers %]
  # workerd (the Cloudflare Workers runtime) is pulled in by wrangler at deploy
  # time; approve its build or `wrangler deploy` fails ERR_PNPM_IGNORED_BUILDS.
  workerd: true
[% endif %]

overrides:
  # --- harmon-init security floors (template-owned; updated by copier update) ---
  # esbuild <0.28.1: dev-server arbitrary file reads on Windows; consumers 2026-10-09.
  # Astro/Vite still resolve 0.27.x — force the patched line until they catch up.
  esbuild: '>=0.28.1 <1'
  # sharp: GHSA-wq5f-xc86-pv6w, GHSA-g89c-p67h-r497, GHSA-2jg2-4ch7-h545.
  sharp: '>=0.35.5 <1'
  # source-map-js: GHSA-68fv-2mgg-jv7q.
  source-map-js: '>=1.2.2 <2'
  # devalue: GHSA-j22f-vq7h-c4qm, GHSA-mcm9-63f2-9j32.
  devalue: '>=5.9.3 <6'
  # http-cache-semantics: GHSA-ch52-4w7c-c8xp.
  http-cache-semantics: '>=4.3.0 <5'
  # brace-expansion: GHSA-6j4f-fj2g-mc7p, GHSA-mh99-v99m-4gvg; no patched 1.x/2.x.
  # Crossing to 5.x requires minimatch@3's companion upgrade below for its API.
  brace-expansion: '>=5.0.10 <6'
  # minimatch@3: companion to brace-expansion's GHSA-mh99-v99m-4gvg major crossing.
  minimatch@3: '>=10.2.5 <11'
  # postcss: evanharmon-site floor recorded 2026-10-09.
  postcss: '>=8.5.18 <9'
  # js-yaml: GHSA-2883-xcg3-v3hh.
  js-yaml@4: '>=4.3.2 <5'
  # nanoid: evanharmon-site floor recorded 2026-10-09; preserve its 3.x API.
  nanoid@3: '>=3.3.18 <4'
  # fast-uri@3: evanharmon-site host-confusion/SSRF floor recorded 2026-10-09.
  fast-uri@3: '>=3.1.6 <4'
  # fast-uri@4: ponderous-site host-confusion/SSRF floor recorded 2026-10-09.
  fast-uri@4: '>=4.1.3 <5'
  # smol-toml: evanharmon-site floor recorded 2026-10-09.
  smol-toml: '>=1.7.1 <2'
  # svgo: GHSA-w27v-7q3p-w38r.
  svgo@4: '>=4.1.0 <5'
  # undici: GHSA-4cwx-7wf7-3272, GHSA-rfgv-xxqx-mfg5, GHSA-w293-vg96-wgc3.
  undici: '>=7.29.1 <8'
  # --- end harmon-init security floors; repository-local floors go below this line ---

# pnpm 11 defaults minimumReleaseAge to 1440 (1 day) — freshly published
# versions won't resolve until they age. To install a pinned release younger
# than that, add version-pinned entries here (they become harmless no-ops once
# the version ages past the cooldown):
# minimumReleaseAgeExclude:
#   - some-package@1.2.3
