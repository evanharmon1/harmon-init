#!/usr/bin/env bash
# test-terraform-provider-locks.sh — hermetic regression for provider-lock
# update/check behavior. A fake Terraform binary avoids registry access.
set -euo pipefail

# Hooks and other callers must not retarget Git commands into their repository.
while IFS= read -r git_var; do
    case "$git_var" in
    GIT_*) unset "$git_var" ;;
    esac
done < <(compgen -v)
# Keep the scratch repositories independent of the caller's Git configuration.
export GIT_CONFIG_GLOBAL=/dev/null
export GIT_CONFIG_SYSTEM=/dev/null
export GIT_CONFIG_NOSYSTEM=1

fail() {
    echo "TEST FAIL: $*" >&2
    exit 1
}

tmp="$(mktemp -d -t test-terraform-provider-locks-XXXXXX)" || exit 1
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
# Hooks report their physical $PWD, so compare against physical paths: the
# temp directory can sit behind a symlink (macOS /var -> /private/var).
tmp="$(cd "$tmp" && pwd -P)" || exit 1
fake_terraform="$tmp/terraform"

cat >"$fake_terraform" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

case "${1:-}" in
-chdir=*) root="${1#-chdir=}" ;;
*) exit 2 ;;
esac
shift

case "${1:-}" in
init)
    upgrade=false
    for arg in "$@"; do
        if [ "$arg" = -upgrade ]; then
            upgrade=true
        fi
    done
    if [ -f "$root/expect-init-upgrade.fixture" ] && [ "$upgrade" != true ]; then
        echo "update init omitted -upgrade" >&2
        exit 8
    fi
    if [ -f "$root/forbid-init-upgrade.fixture" ] && [ "$upgrade" = true ]; then
        echo "check init unexpectedly used -upgrade" >&2
        exit 8
    fi
    if [ -f "$root/local-module.fixture" ] &&
        [ ! -f "$root/../../modules/example/main.tf" ]; then
        echo "local module was not copied" >&2
        exit 9
    fi
    ;;
providers)
    shift
    [ "${1:-}" = lock ] || exit 2
    [ -f "$root/required-provider.fixture" ] || exit 0
    lock="$root/.terraform.lock.hcl"
    touch "$lock"
    grep -Fq '# platform: darwin_arm64' "$lock" ||
        printf '%s\n' '# platform: darwin_arm64' >>"$lock"
    grep -Fq '# platform: linux_amd64' "$lock" ||
        printf '%s\n' '# platform: linux_amd64' >>"$lock"
    ;;
*) exit 2 ;;
esac
EOF
chmod +x "$fake_terraform"

helper=./scripts/terraform-provider-locks.sh

empty_root="$tmp/empty"
mkdir "$empty_root"
printf '%s\n' 'terraform {}' >"$empty_root/main.tf"
TERRAFORM_BIN="$fake_terraform" "$helper" check "$empty_root" >/dev/null ||
    fail "provider-free root did not skip cleanly"
[ ! -e "$empty_root/.terraform.lock.hcl" ] ||
    fail "provider-free check created a lockfile"

incomplete_root="$tmp/incomplete"
mkdir "$incomplete_root"
: >"$incomplete_root/required-provider.fixture"
printf '%s\n' '# platform: darwin_arm64' >"$incomplete_root/.terraform.lock.hcl"
before="$(cksum "$incomplete_root/.terraform.lock.hcl")"
if TERRAFORM_BIN="$fake_terraform" "$helper" check "$incomplete_root" >/dev/null 2>&1; then
    fail "incomplete multi-platform lock passed"
fi
after="$(cksum "$incomplete_root/.terraform.lock.hcl")"
[ "$before" = "$after" ] || fail "lock check mutated the checkout"

complete_root="$tmp/complete"
mkdir "$complete_root"
: >"$complete_root/required-provider.fixture"
: >"$complete_root/forbid-init-upgrade.fixture"
printf '%s\n' \
    '# platform: darwin_arm64' \
    '# platform: linux_amd64' >"$complete_root/.terraform.lock.hcl"
TERRAFORM_BIN="$fake_terraform" "$helper" check "$complete_root" >/dev/null ||
    fail "complete multi-platform lock failed"

update_root="$tmp/update"
mkdir "$update_root"
: >"$update_root/required-provider.fixture"
: >"$update_root/expect-init-upgrade.fixture"
printf '%s\n' '# stale provider selection' >"$update_root/.terraform.lock.hcl"
TERRAFORM_BIN="$fake_terraform" "$helper" update "$update_root" >/dev/null ||
    fail "provider-lock update failed"
grep -Fq '# platform: darwin_arm64' "$update_root/.terraform.lock.hcl" ||
    fail "update omitted darwin_arm64"
grep -Fq '# platform: linux_amd64' "$update_root/.terraform.lock.hcl" ||
    fail "update omitted linux_amd64"

module_repo="$tmp/module repo"
module_root="$module_repo/terraform/environments/production env"
mkdir -p "$module_root" "$module_repo/terraform/modules/example"
git -C "$module_repo" init -q
: >"$module_root/required-provider.fixture"
: >"$module_root/local-module.fixture"
printf '%s\n' \
    '# platform: darwin_arm64' \
    '# platform: linux_amd64' >"$module_root/.terraform.lock.hcl"
printf '%s\n' 'module "example" { source = "../../modules/example" }' >"$module_root/main.tf"
printf '%s\n' 'terraform {}' >"$module_repo/terraform/modules/example/main.tf"
git -C "$module_repo" add .
module_status_before="$(git -C "$module_repo" status --porcelain)"
TERRAFORM_BIN="$fake_terraform" "$helper" check "$module_root" >/dev/null ||
    fail "uninitialized local-module root failed in the scratch checkout"
module_status_after="$(git -C "$module_repo" status --porcelain)"
[ "$module_status_before" = "$module_status_after" ] ||
    fail "local-module lock check mutated the checkout"

untracked_repo="$tmp/untracked repo"
untracked_root="$untracked_repo/terraform"
mkdir -p "$untracked_root"
git -C "$untracked_repo" init -q
: >"$untracked_root/required-provider.fixture"
: >"$untracked_root/forbid-init-upgrade.fixture"
printf '%s\n' 'terraform {}' >"$untracked_root/main.tf"
# A complete, current lock — it fails only because Git does not have it, which
# is what the commit CI checks out would look like.
printf '%s\n' \
    '# platform: darwin_arm64' \
    '# platform: linux_amd64' >"$untracked_root/.terraform.lock.hcl"
git -C "$untracked_repo" add terraform/main.tf
if TERRAFORM_BIN="$fake_terraform" "$helper" check "$untracked_root" >/dev/null 2>&1; then
    fail "lock that Git does not track passed the check"
fi
# `git add -N` records the path with no content, so the commit still omits the
# lock even though the index answers "tracked" for it.
git -C "$untracked_repo" add -N terraform/.terraform.lock.hcl
if TERRAFORM_BIN="$fake_terraform" "$helper" check "$untracked_root" >/dev/null 2>&1; then
    fail "intent-to-add lock passed the check"
fi
git -C "$untracked_repo" add terraform/.terraform.lock.hcl
TERRAFORM_BIN="$fake_terraform" "$helper" check "$untracked_root" >/dev/null ||
    fail "lock passed to Git still failed the check"
# `git rm --cached` leaves the file on disk while the next commit deletes it.
git -C "$untracked_repo" rm --cached -q terraform/.terraform.lock.hcl
if TERRAFORM_BIN="$fake_terraform" "$helper" check "$untracked_root" >/dev/null 2>&1; then
    fail "lock removed from the index passed the check"
fi

# Exercise Git's actual pre-commit environment in each supported layout.
# The hook uses the caller's checkout root, and each repository owns its hook.
export PROVIDER_LOCK_TEST_HELPER="$(cd scripts && pwd -P)/terraform-provider-locks.sh"
export TERRAFORM_BIN="$fake_terraform"
layout_git() {
    case "$layout" in
    ordinary | linked) git -C "$hook_tree" "$@" ;;
    external)
        (cd "$hook_tree" && GIT_DIR="$hook_gitdir" GIT_WORK_TREE="$hook_tree" git "$@")
        ;;
    core-worktree)
        (cd "$hook_tree" && GIT_DIR="$hook_gitdir" git "$@")
        ;;
    esac
}

for layout in ordinary linked external core-worktree; do
    hook_tree="$tmp/$layout tree"
    hook_gitdir="$tmp/$layout.git"
    mkdir "$hook_tree"
    case "$layout" in
    ordinary) git -C "$hook_tree" init -q ;;
    linked)
        parent_repo="$tmp/linked parent"
        git init -q "$parent_repo"
        git -C "$parent_repo" -c user.name="Provider Lock Test" \
            -c user.email=test@example.invalid -c core.hooksPath=/dev/null \
            commit -qm "worktree fixture" --allow-empty
        git -C "$parent_repo" worktree add -q -b linked-lock-test "$hook_tree"
        ;;
    external) git init -q --bare "$hook_gitdir" ;;
    core-worktree)
        git init -q --bare "$hook_gitdir"
        git --git-dir="$hook_gitdir" config core.bare false
        git --git-dir="$hook_gitdir" config core.worktree "$hook_tree"
        ;;
    esac
    layout_git config user.name "Provider Lock Test"
    layout_git config user.email test@example.invalid
    hook_dir="$tmp/$layout hooks"
    mkdir "$hook_dir"
    layout_git config core.hooksPath "$hook_dir"
    cat >"$hook_dir/pre-commit" <<'HOOK'
#!/usr/bin/env bash
set -euo pipefail
exec "$PROVIDER_LOCK_TEST_HELPER" check "$PWD/terraform"
HOOK
    chmod +x "$hook_dir/pre-commit"
    hook_root="$hook_tree/terraform"
    mkdir "$hook_root"
    cp -R "$complete_root/." "$hook_root/"
    printf '%s\n' 'terraform {}' >"$hook_root/main.tf"
    layout_git add terraform
    if ! hook_output="$(layout_git commit -qm "staged provider lock" 2>&1)"; then
        fail "$layout: staged lock failed in the pre-commit hook: $hook_output"
    fi
    layout_git rm --cached -q terraform/.terraform.lock.hcl
    if hook_output="$(layout_git commit -qm "missing provider lock" 2>&1)"; then
        fail "$layout: lock missing from the index passed the pre-commit hook"
    fi
    case "$hook_output" in
    *"Terraform provider lock will not be part of the commit: $hook_root/.terraform.lock.hcl"*) ;;
    *) fail "$layout: missing lock gave the wrong diagnostic: $hook_output" ;;
    esac
    echo "Terraform provider-lock hooks: $layout PASS (staged accepted, missing rejected)"
done

echo "Terraform provider-lock regression: PASS"
