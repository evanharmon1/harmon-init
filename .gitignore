# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor / IDE files
.idea/
*.swp
*~
# VS Code: commit the curated shared project config, ignore everything else
# (extensions auto-write machine-specific files into .vscode/). The broad ignore
# MUST come before the `!` whitelist — later rules win in .gitignore. `!/.vscode/`
# re-includes the DIRECTORY first: a global excludesFile with a bare `.vscode/`
# is common, and git never descends into an ignored directory, so without it the
# file-level whitelist below silently does nothing for those users (the same
# global-gitignore hazard called out for `.meta` below). Anchored with a leading
# slash so it only re-includes the ROOT .vscode/ — an unanchored `!.vscode/`
# would also un-ignore nested ones (e.g. packages/foo/.vscode/) whose
# machine-specific files the root-anchored `.vscode/*` above does not cover.
.vscode/*
!/.vscode/
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json

# Homebrew lockfile (generated by `brew bundle`)
Brewfile.lock.json

# Node dependencies — kept in every profile (a local node_modules can appear from
# ad-hoc npm or a v2->v3 migration even in non-node repos). Build output and the
# pnpm store stay node-profile-only, in the template's use_node block.
node_modules/

# logs and databases
*.log
*.sql
*.sqlite
*.sqlite3

# Taskfile fingerprint cache
.task/

# Python bytecode. Trees that ran foreman v1 (pre-#584) still carry an orphaned
# scripts/foreman/__pycache__ that was never tracked, so a checkout that predates
# it is dirty before anyone edits anything. More generally, copier's dirty-tree
# wip commit stages with `git add -A`, so any unignored bytecode would be swept
# into every local render.
__pycache__/
*.pyc

# Git worktrees
.worktrees/
# Agent-tool worktree isolation dir. A registered worktree is recorded as a
# gitlink with no `.gitmodules` entry, and copier's dirty-tree wip commit stages
# with `git add -A`, so an unignored one is swept into every local render — the
# nested clone then dies with `fatal: No url found for submodule path …`, an
# error naming submodules in a repo that has none. Anchored by its embedded
# slash (git anchors any pattern containing a non-trailing `/`), so it matches
# only the root `.claude/` and never `template/.claude/`.
.claude/worktrees/

# Design handoff bundles (Claude Design exports) live as specs/ subdirectories
# while being implemented and are deleted at sign-off — never committed.
# Top-level specs/*.md (README, _template, feature specs) stay tracked.
specs/*/

# Lefthook local overrides (not committed)
.lefthook-local.yml

# Local editor/AI settings
settings.local.json

# Scratch — anchored to root. Unanchored `.meta` also matched template/.meta and
# got dropped from copier's dirty-tree wip commit (empty-index clone + add -A).
/.meta
/todo.md
# Re-include the template's .meta — global gitignores often ignore `.meta`
# unanchored, which silently drops these files from copier's dirty-tree wip
# commit (clone --no-checkout has an empty index, so ignore rules apply even
# to tracked files during its `git add -A`).
!template/.meta/
!template/.meta/**

# Root-only: harmon-init IS the template, so it renders neither a workspace file
# nor an answers file of its own (generated repos track both).
*.code-workspace
.copier-answers.yml
.copier-answers.yml.backup

# Foreman runtime artifacts (logs, prompts, resume states — never state-of-record)
.foreman/
.foreman-stop

# Devcontainer env files (injected locally via 1Password, never committed)
.devcontainer/**/devcontainer.env

# Devcontainer feature lockfile — regenerated on each container build (pins
# resolved feature digests); a local build artifact, never committed.
.devcontainer/**/devcontainer-lock.json

#             .env
#------------------------------------------------------------------------------
# Ignore all .env files everywhere (secrets live in 1Password; see docs/CHECKLIST.md)
.env
**/.env
.env.*
**/.env.*
.env/
# ...but keep the committed example (documents required vars; contains no secrets).
!/.env.example
