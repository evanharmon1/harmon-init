{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evanharmon1.github.io/harmon-init/devflow.schema.json",
  "title": "Harmon Init devflow configuration v2",
  "description": "Structural contract for schema-version 2 policy files; cross-file references are validated by scripts/test-devflow-config.sh.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "default_rigor",
    "default_strategy",
    "rigor_order",
    "tier_order",
    "rigor",
    "rounds",
    "breadth",
    "gates",
    "convergence",
    "role",
    "stage",
    "strategy"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "default_rigor": { "type": "string" },
    "default_strategy": { "type": "string" },
    "rigor_order": { "$ref": "#/$defs/strings" },
    "tier_order": { "$ref": "#/$defs/strings" },
    "rigor": { "$ref": "#/$defs/rigor_profiles" },
    "rounds": { "$ref": "#/$defs/round_profiles" },
    "breadth": { "$ref": "#/$defs/breadth_profiles" },
    "spend": { "$ref": "#/$defs/spend_profiles" },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["round_code", "round_docs", "secret_scan", "pre_pr", "docs_only_paths"],
      "properties": {
        "round_code": { "type": "string" },
        "round_docs": { "type": "string" },
        "secret_scan": { "type": "string" },
        "pre_pr": { "type": "string" },
        "docs_only_paths": { "$ref": "#/$defs/strings" }
      }
    },
    "convergence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["converged", "diverging"],
      "properties": {
        "converged": { "$ref": "#/$defs/convergence_expression" },
        "diverging": { "$ref": "#/$defs/convergence_expression" }
      }
    },
    "role": { "$ref": "#/$defs/role_profiles" },
    "stage": { "$ref": "#/$defs/stage_profiles" },
    "strategy": { "$ref": "#/$defs/strategy_profiles" }
  },
  "$defs": {
    "strings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "tier": { "type": "string", "enum": ["local", "economy", "standard", "frontier", "apex"] },
    "rigor_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rounds",
        "breadth",
        "orchestrator_tier",
        "implementer_tier",
        "challenger_tier",
        "reviewer_tier",
        "integrator_tier",
        "tier_escalation",
        "description"
      ],
      "properties": {
        "rounds": { "type": "string", "minLength": 1 },
        "breadth": { "type": "string", "minLength": 1 },
        "orchestrator_tier": { "$ref": "#/$defs/tier" },
        "implementer_tier": { "$ref": "#/$defs/tier" },
        "challenger_tier": { "$ref": "#/$defs/tier" },
        "reviewer_tier": { "$ref": "#/$defs/tier" },
        "integrator_tier": { "$ref": "#/$defs/tier" },
        "tier_escalation": { "type": "boolean" },
        "description": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "rigor_profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/rigor_profile" }
    },
    "round_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "challenge",
        "review",
        "integration",
        "remediation",
        "min_rounds",
        "wall_clock_min"
      ],
      "properties": {
        "challenge": { "type": "integer", "minimum": 0 },
        "review": { "type": "integer", "minimum": 0 },
        "integration": { "type": "integer", "minimum": 0 },
        "remediation": { "type": "integer", "minimum": 0 },
        "min_rounds": { "type": "integer", "minimum": 0 },
        "wall_clock_min": { "type": "integer", "minimum": 1 }
      }
    },
    "round_profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/round_profile" }
    },
    "breadth_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_agent_runs", "max_parallel_agents"],
      "properties": {
        "max_agent_runs": { "type": "integer", "minimum": 1 },
        "max_parallel_agents": { "type": "integer", "minimum": 1 }
      }
    },
    "breadth_profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/breadth_profile" }
    },
    "spend_profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_tokens": { "type": "integer", "minimum": 1 },
        "max_usd": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "spend_profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/spend_profile" }
    },
    "role_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "families"],
      "properties": {
        "tier": { "$ref": "#/$defs/tier" },
        "families": { "$ref": "#/$defs/strings" },
        "harnesses": { "$ref": "#/$defs/strings" }
      }
    },
    "role_profiles": {
      "type": "object",
      "minProperties": 5,
      "additionalProperties": { "$ref": "#/$defs/role_profile" }
    },
    "stage_profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "finders": { "$ref": "#/$defs/strings" },
        "finder_fallbacks": { "$ref": "#/$defs/strings" },
        "pool": { "$ref": "#/$defs/strings" }
      }
    },
    "stage_profiles": {
      "type": "object",
      "minProperties": 4,
      "additionalProperties": { "$ref": "#/$defs/stage_profile" }
    },
    "strategy_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topology", "planning", "delegation", "human_gates", "description"],
      "properties": {
        "topology": {
          "enum": ["single-agent", "lead-and-workers", "independent-proposals", "human-directed"]
        },
        "planning": { "enum": ["inline", "explicit", "independent", "collaborative"] },
        "delegation": { "enum": ["none", "optional", "required"] },
        "human_gates": {
          "type": "array",
          "items": { "$ref": "#/$defs/human_gate" },
          "uniqueItems": true
        },
        "description": { "type": "string", "minLength": 1, "maxLength": 100 },
        "coordination": { "const": "parallel-when-independent" },
        "selection": { "const": "judge" },
        "synthesis": { "type": "boolean" },
        "min_agents": { "type": "integer", "minimum": 2 },
        "distinct_families": { "type": "boolean" }
      }
    },
    "human_gate": {
      "enum": [
        "after-discovery",
        "after-plan",
        "before-delegation",
        "before-selection",
        "before-synthesis",
        "before-scope-expansion",
        "before-budget-escalation",
        "before-publication",
        "before-ready-for-review",
        "each-phase"
      ]
    },
    "strategy_profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/strategy_profile" }
    },
    "convergence_expression": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "predicate": {
          "enum": ["no_gating_findings", "provenance_share", "count_rising", "repeat_after_fix"]
        },
        "any": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/convergence_expression" }
        },
        "all": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/convergence_expression" }
        },
        "increases": { "type": "integer", "minimum": 1 },
        "min": { "type": "number", "minimum": 0, "maximum": 1 },
        "exclude_classes": { "$ref": "#/$defs/strings" }
      }
    }
  }
}
