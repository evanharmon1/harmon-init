# versions.env — the single source of truth for every tool pin on the REMOTE
# path.
#
# The shared devcontainer image and the stock-Ubuntu bootstrap
# (bootstrap-remote.sh) install these tools by running the SAME scripts under
# install/, which read their versions from this file and from nowhere else.
# Bumping a version here therefore updates the devcontainer and every remote
# environment together, and a remote bootstrap cannot pin anything the image
# does not. scripts/test-bootstrap-remote.sh fails if any install script or the
# bootstrap declares a pin of its own.
#
# Image-only tools (Terraform, TFLint, the interactive-terminal tools, the
# other agent CLIs) keep their `ARG` pins in the Dockerfile: the bootstrap never
# installs them, so moving them here would widen the file without serving the
# invariant.
#
# Shape: plain `NAME=value` shell assignments, sourced with
# `set -a; . versions.env; set +a`. Values are unquoted because Renovate's
# custom manager captures the raw token — a quoted value ends up inside
# currentValue and pep440/semver reject it (scripts/test-renovate-pins.sh).

# ---------- language runtimes ----------
# Node ships as a checksum-pinned nodejs.org tarball rather than the
# deb.nodesource.com apt repository: that host is denied on the Claude Code on
# the web VM (observed 2026-09-27), and the apt repo pinned only the MAJOR, so
# two builds of the same image could ship different Node patch releases.
# renovate: datasource=node-version depName=node
NODE_VERSION=24.22.1 # pin-pair: node
# nodejs.org publishes SHASUMS256.txt rather than release attachments, so these
# digests are NOT Renovate-managed. Before moving NODE_VERSION a person must
# read https://nodejs.org/dist/v<version>/SHASUMS256.txt and copy the
# linux-x64 / linux-arm64 `.tar.xz` lines here. Each digest carries its own
# `# verified-for:` marker, which plays the role the Renovate `digestVersion=`
# annotation plays for the uv digests below: scripts/test-bootstrap-remote.sh
# fails fast until BOTH markers name NODE_VERSION, and its merge-base drift
# check fails if NODE_VERSION moves and either digest does not.
# verified-for: 24.22.1
node_amd64_sha256=6c172a9ab6718f7b801fb5a7bd486af2ee5e32758086a04b84fcce2aa77095e6 # pin-pair: node
# verified-for: 24.22.1
node_arm64_sha256=dbabf7a1cbf947e6059ffad2c27b80041db97dea1e553b62afdee7f13fca336e # pin-pair: node

# uv ships from its checksum-pinned GitHub release rather than the astral.sh
# installer, for the same reachability reason (astral.sh is denied).
# renovate: datasource=github-releases depName=astral-sh/uv extractVersion=^v?(?<version>.+)$
UV_VERSION=0.13.5 # pin-pair: uv
# renovate: datasource=github-release-attachments depName=astral-sh/uv digestVersion=0.13.5
uv_amd64_sha256=f68d291c75783122dad58ab77def0e13f3233f358731db5d6d7e8715603b928f # pin-pair: uv
# renovate: datasource=github-release-attachments depName=astral-sh/uv digestVersion=0.13.5
uv_arm64_sha256=4bb69cf95ed13f23713bb7bc09f241896ea0c75b7c557e615a20604b82f9c403 # pin-pair: uv

# ---------- core tier: the dev-loop gate ----------
# renovate: datasource=github-releases depName=go-task/task extractVersion=^v?(?<version>.+)$
TASK_VERSION=3.54.0
# renovate: datasource=github-releases depName=evilmartians/lefthook extractVersion=^v?(?<version>.+)$
LEFTHOOK_VERSION=2.2.2
# The GitHub CLI comes from its release tarball, not cli.github.com's apt
# repository (denied on the remote VM) and not the devcontainer base image —
# the bootstrap must not depend on a base it does not have.
# renovate: datasource=github-releases depName=cli/cli extractVersion=^v?(?<version>.+)$
GH_VERSION=2.103.0
# renovate: datasource=github-releases depName=mikefarah/yq extractVersion=^v?(?<version>.+)$
YQ_VERSION=4.54.1
# ShellCheck matches the setup action; both architectures verify the release archive.
# renovate: datasource=github-releases depName=koalaman/shellcheck extractVersion=^v(?<version>.+)$
SHELLCHECK_VERSION=0.11.0 # pin-pair: shellcheck
# renovate: datasource=github-release-attachments depName=koalaman/shellcheck digestVersion=v0.11.0
shellcheck_amd64_sha256=8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198 # pin-pair: shellcheck
# renovate: datasource=github-release-attachments depName=koalaman/shellcheck digestVersion=v0.11.0
shellcheck_arm64_sha256=12b331c1d2db6b9eb13cfca64306b1b157a86eb69db83023e261eaa7e7c14588 # pin-pair: shellcheck
# renovate: datasource=github-releases depName=mvdan/sh extractVersion=^v?(?<version>.+)$
SHFMT_VERSION=3.14.1
# renovate: datasource=github-releases depName=rhysd/actionlint extractVersion=^v?(?<version>.+)$
ACTIONLINT_VERSION=1.7.12
# renovate: datasource=github-releases depName=hadolint/hadolint extractVersion=^v?(?<version>.+)$
HADOLINT_VERSION=2.15.1
# renovate: datasource=github-releases depName=gitleaks/gitleaks extractVersion=^v?(?<version>.+)$
GITLEAKS_VERSION=8.30.1
# renovate: datasource=github-releases depName=lycheeverse/lychee extractVersion=^lychee-v(?<version>.+)$
LYCHEE_VERSION=0.24.2
# renovate: datasource=pypi depName=semgrep
SEMGREP_VERSION=1.182.1
# renovate: datasource=pypi depName=copier
COPIER_VERSION=9.19.1
# Must equal MARKDOWNLINT_VERSION in scripts/markdownlint.sh, which is what
# `task lint:markdown` actually runs (it prefers a repo-local install and
# otherwise npx's that exact version). Both sit in Renovate's Formatters
# group (renovate.json's markdownlint-cli2 rule reclaims both copies from the
# Devcontainer batch) so one PR moves them together, and
# scripts/test-bootstrap-remote.sh fails if they ever disagree.
# renovate: datasource=npm depName=markdownlint-cli2
MARKDOWNLINT_CLI2_VERSION=0.24.0

# ---------- agents tier ----------
# The Codex CLI only. It is used where an environment persists and holds its own
# Codex login (#1406); ephemeral clouds install it and never log in. Every other
# agent CLI stays image-only.
# renovate: datasource=npm depName=@openai/codex
CODEX_VERSION=0.163.0

# ---------- browsers tier (opt-in) ----------
# renovate: datasource=npm depName=@playwright/test
PLAYWRIGHT_VERSION=1.64.1
# renovate: datasource=npm depName=@playwright/cli
PLAYWRIGHT_CLI_VERSION=0.1.22
