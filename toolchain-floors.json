{
  "schema_version": 2,
  "floors": [
    {
      "tool": "node",
      "minimum": "24",
      "compare": "major",
      "pins": [
        {
          "path": ".github/actions/setup/action.yml",
          "template_path": "template/.github/actions/setup/action.yml.jinja",
          "step": { "action": "actions/setup-node", "input": "node-version" },
          "pattern": "^[ ]*node-version:(?:[ \\t]+|[ \\t]*(?:#[^\\r\\n]*)?\\r?\\n[ ]+)(?=[\"']?(0|[1-9][0-9]*))([\"']?)(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*))?\\2(?:[ \\t]+#[^\\r\\n]*)?[ \\t]*\\r?$"
        },
        {
          "path": ".github/workflows/devcontainer-build.yml",
          "template_path": "template/.github/workflows/[% if devcontainer %]devcontainer-build.yml[% endif %].jinja",
          "step": { "action": "actions/setup-node", "input": "node-version" },
          "pattern": "^[ ]*node-version:(?:[ \\t]+|[ \\t]*(?:#[^\\r\\n]*)?\\r?\\n[ ]+)(?=[\"']?(0|[1-9][0-9]*))([\"']?)(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*))?\\2(?:[ \\t]+#[^\\r\\n]*)?[ \\t]*\\r?$"
        },
        {
          "path": ".github/workflows/classification-reconcile.yml",
          "template_path": "template/.github/workflows/[% if project_management == 'github' %]classification-reconcile.yml[% endif %].jinja",
          "step": { "action": "actions/setup-node", "input": "node-version" },
          "pattern": "^[ ]*node-version:(?:[ \\t]+|[ \\t]*(?:#[^\\r\\n]*)?\\r?\\n[ ]+)(?=[\"']?(0|[1-9][0-9]*))([\"']?)(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*))?\\2(?:[ \\t]+#[^\\r\\n]*)?[ \\t]*\\r?$"
        }
      ]
    },
    {
      "tool": "pnpm",
      "minimum": "11",
      "compare": "major",
      "when": "use_node",
      "pins": [
        {
          "path": "package.json",
          "template_path": null,
          "json_pointer": "/packageManager",
          "pattern": "^pnpm@(0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?!0[0-9]+(?:[.+]|$))[0-9A-Za-z-]+(?:\\.(?!0[0-9]+(?:[.+]|$))[0-9A-Za-z-]+)*)?(?:\\+(?:sha512\\.[0-9a-fA-F]+|(?!sha512(?:\\.|$))[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?(?![\\s\\S])"
        }
      ]
    },
    {
      "tool": "copier",
      "minimum": "9.8.0",
      "compare": "version",
      "pins": []
    },
    {
      "tool": "task",
      "minimum": "3.51.1",
      "compare": "version",
      "pins": [
        {
          "path": ".github/actions/setup/action.yml",
          "template_path": "template/.github/actions/setup/action.yml.jinja",
          "step": { "action": "arduino/setup-task", "input": "version", "pattern_scope": "value" },
          "pattern": "^([0-9]+\\.[0-9]+\\.[0-9]+)(?![\\s\\S])"
        },
        {
          "path": ".github/workflows/release-content-guard.yml",
          "template_path": "template/.github/workflows/[% if use_release_please and release_content_paths %]release-content-guard.yml[% endif %].jinja",
          "step": { "action": "arduino/setup-task", "input": "version", "pattern_scope": "value" },
          "pattern": "^([0-9]+\\.[0-9]+\\.[0-9]+)(?![\\s\\S])"
        }
      ]
    },
    {
      "tool": "devcontainer-image",
      "minimum": "6018a312f4386f6dd5bf342ab9e44877f16a6dd3",
      "compare": "ancestor",
      "when": "devcontainer",
      "pins": [
        {
          "path": ".devcontainer/Dockerfile",
          "template_path": "template/[% if devcontainer %].devcontainer[% endif %]/Dockerfile",
          "pattern": "^FROM ghcr\\.io/evanharmon1/harmon-devcontainer:sha-([0-9a-f]{40})@"
        }
      ]
    }
  ]
}
