{
  "schema_version": 1,
  "floors": [
    {
      "tool": "node",
      "minimum": "24",
      "compare": "major",
      "pins": [
        {
          "path": ".github/actions/setup/action.yml",
          "template_path": "template/.github/actions/setup/action.yml.jinja",
          "pattern": "^\\s*node-version: [\"']?(.*?)[\"']?\\s*(?:\\s#.*)?$"
        }
      ]
    },
    {
      "tool": "pnpm",
      "minimum": "11",
      "compare": "major",
      "when": "use_node",
      "pins": [
        {
          "path": "package.json",
          "template_path": null,
          "json_pointer": "/packageManager",
          "pattern": "^pnpm@([0-9]+)\\.[0-9]+\\.[0-9]+(?:[-+].*)?$"
        }
      ]
    },
    {
      "tool": "copier",
      "minimum": "9.8.0",
      "compare": "version",
      "pins": []
    },
    {
      "tool": "task",
      "minimum": "3.51.1",
      "compare": "version",
      "pins": [
        {
          "path": ".github/actions/setup/action.yml",
          "template_path": "template/.github/actions/setup/action.yml.jinja",
          "pattern": "^\\s*- uses: arduino/setup-task@[^\\n]*\\n(?:(?!\\s*- )[^\\n]*\\n)*?\\s*version: ([0-9]+\\.[0-9]+\\.[0-9]+)$"
        }
      ]
    },
    {
      "tool": "devcontainer-image",
      "minimum": "6018a312f4386f6dd5bf342ab9e44877f16a6dd3",
      "compare": "ancestor",
      "when": "devcontainer",
      "pins": [
        {
          "path": ".devcontainer/Dockerfile",
          "template_path": "template/[% if devcontainer %].devcontainer[% endif %]/Dockerfile",
          "pattern": "^FROM ghcr\\.io/evanharmon1/harmon-devcontainer:sha-([0-9a-f]{40})@"
        }
      ]
    }
  ]
}
